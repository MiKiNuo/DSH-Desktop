<UserControl
    x:Class="DshDesktop.Presentation.Avalonia.Features.Runtime.RuntimeView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:DshDesktop.Presentation.Avalonia.Features.Runtime"
    x:DataType="vm:RuntimeViewModel">
    <!--
      Runtime 页（Phase 8 Issue 04，视觉基准 docs/DSH-Desktop-UI-Redesign.html #p-runtime）：
      状态机 stepper 卡（eyebrow + 头部分段按钮 + 生命周期图标 + 正常/异常流转 stepper + 失败恢复 + 安全模式）
      + 运行环境 KV 卡 + 启动与恢复策略卡。
      Failed 恢复面板（ADR-0004）与状态机高亮在 code-behind（ApplyIndicators）。
    -->
    <ScrollViewer>
        <StackPanel Margin="24" Spacing="14">
            <Grid ColumnDefinitions="1.2*,0.8*">

                <!-- ===== 状态机卡 ===== -->
                <Border Classes="card" Padding="18" Grid.Column="0">
                    <StackPanel Spacing="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock
                                Classes="eyebrow"
                                VerticalAlignment="Center"
                                Text="DSH RUNTIME STATE MACHINE" />
                            <StackPanel
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8">
                                <Button
                                    Classes="btn secondary"
                                    Command="{Binding RestartRuntimeCommand}"
                                    Content="重启 Runtime" />
                                <Button
                                    x:Name="StopButton"
                                    Classes="btn danger"
                                    Command="{Binding StopRuntimeCommand}"
                                    Content="停止 DSH" />
                            </StackPanel>
                        </Grid>

                        <!-- 生命周期图标 + 标题 -->
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <Border
                                x:Name="LifecycleIconBorder"
                                Classes="ready-icon"
                                Width="34"
                                Height="34"
                                CornerRadius="17">
                                <Path
                                    x:Name="LifecycleIcon"
                                    Classes="icon"
                                    Data="{DynamicResource IconCheck}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock
                                    Classes="hero-title"
                                    FontSize="18"
                                    Text="{Binding Lifecycle}" />
                                <TextBlock Classes="hero-sub" Text="{Binding StatusSubtitle}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- 状态机 stepper：正常流转 Stopped→Starting→Running→Stopping -->
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Classes="fsm-label" Text="正常流转" />
                                <Border x:Name="PillStopped" Classes="state off">
                                    <TextBlock Text="Stopped" />
                                </Border>
                                <Path Classes="icon icon-sm fsm-arrow" Data="{DynamicResource IconChevronRight}" />
                                <Border x:Name="PillStarting" Classes="state off">
                                    <TextBlock Text="Starting" />
                                </Border>
                                <Path Classes="icon icon-sm fsm-arrow" Data="{DynamicResource IconChevronRight}" />
                                <Border x:Name="PillRunning" Classes="state off">
                                    <TextBlock Text="Running" />
                                </Border>
                                <Path Classes="icon icon-sm fsm-arrow" Data="{DynamicResource IconChevronRight}" />
                                <Border x:Name="PillStopping" Classes="state off">
                                    <TextBlock Text="Stopping" />
                                </Border>
                            </StackPanel>

                            <!-- 异常流转 Failed→Recovering -->
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Classes="fsm-label" Text="异常流转" />
                                <Border x:Name="PillFailed" Classes="state off">
                                    <TextBlock Text="Failed" />
                                </Border>
                                <Path Classes="icon icon-sm fsm-arrow" Data="{DynamicResource IconChevronRight}" />
                                <Border x:Name="PillRecovering" Classes="state off">
                                    <TextBlock Text="Recovering" />
                                </Border>
                                <TextBlock
                                    Classes="fsm-label"
                                    Text="Recovering 完成后回到 Starting" />
                            </StackPanel>
                        </StackPanel>

                        <!-- ADR-0004：Failed 恢复面板（并入状态机卡），仅 Failed 可见。 -->
                        <Border x:Name="RecoverPanel" Classes="notice err" IsVisible="False">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="notice-title" Text="启动失败 · 需要干预" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button
                                        Classes="btn"
                                        Command="{Binding StartRuntimeCommand}"
                                        Content="重试启动" />
                                    <Button
                                        Classes="btn"
                                        Command="{Binding RecoverRuntimeCommand}"
                                        Content="禁用插件后恢复" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 安全模式提示（保留 SafeMode 可见性绑定） -->
                        <Border Classes="notice info" IsVisible="{Binding SafeMode}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Path Classes="icon" Data="{DynamicResource IconShield}" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Classes="notice-title" Text="安全模式" />
                                    <TextBlock
                                        Text="自动启动已抑制，可管理插件与配置。退出安全模式后 Runtime 将按正常链路启动。" />
                                </StackPanel>
                                <Button
                                    Classes="btn secondary sm"
                                    HorizontalAlignment="Right"
                                    Command="{Binding ExitSafeModeCommand}"
                                    Content="退出安全模式" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ===== 运行环境 KV 卡 ===== -->
                <Border Classes="card" Grid.Column="1">
                    <Grid RowDefinitions="Auto,*">
                        <Border Classes="card-head" Grid.Row="0">
                            <TextBlock Classes="card-title" Text="运行环境" />
                        </Border>
                        <Border Classes="card-body" Grid.Row="1">
                            <StackPanel>
                                <Border Classes="kv-row">
                                    <Grid ColumnDefinitions="96,*">
                                        <TextBlock Classes="kv-key" Text="Desktop" />
                                        <TextBlock
                                            Classes="kv-value"
                                            Grid.Column="1"
                                            Text="{Binding DesktopVersion}" />
                                    </Grid>
                                </Border>
                                <Border Classes="kv-row">
                                    <Grid ColumnDefinitions="96,*">
                                        <TextBlock Classes="kv-key" Text="DSH" />
                                        <TextBlock
                                            Classes="kv-value"
                                            Grid.Column="1"
                                            Text="{Binding DshVersion, FallbackValue='—', TargetNullValue='—'}" />
                                    </Grid>
                                </Border>
                                <Border Classes="kv-row">
                                    <Grid ColumnDefinitions="96,*">
                                        <TextBlock Classes="kv-key" Text="Node.js" />
                                        <TextBlock
                                            Classes="kv-value"
                                            Grid.Column="1"
                                            Text="{Binding NodeVersionText}" />
                                    </Grid>
                                </Border>
                                <Border Classes="kv-row">
                                    <Grid ColumnDefinitions="96,*">
                                        <TextBlock Classes="kv-key" Text="WebView2" />
                                        <TextBlock
                                            Classes="kv-value"
                                            Grid.Column="1"
                                            Text="{Binding WebView2VersionText}" />
                                    </Grid>
                                </Border>
                                <Border Classes="kv-row">
                                    <Grid ColumnDefinitions="96,*">
                                        <TextBlock Classes="kv-key" Text="DSH_HOME" />
                                        <TextBlock
                                            Classes="kv-value"
                                            Grid.Column="1"
                                            Text="{Binding DshHomeText}" />
                                    </Grid>
                                </Border>
                                <Border Classes="kv-row">
                                    <Grid ColumnDefinitions="96,*">
                                        <TextBlock Classes="kv-key" Text="Profile" />
                                        <TextBlock
                                            Classes="kv-value"
                                            Grid.Column="1"
                                            Text="{Binding ProfileNameText}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===== 启动与恢复策略卡 ===== -->
            <Border Classes="card">
                <Grid RowDefinitions="Auto,*">
                    <Border Classes="card-head" Grid.Row="0">
                        <StackPanel>
                            <TextBlock Classes="card-title" Text="启动与恢复策略" />
                            <TextBlock Classes="card-subtitle" Text="这些能力由 Avalonia Desktop 管理，不依赖 DSH Web UI" />
                        </StackPanel>
                    </Border>
                    <Border Classes="card-body" Grid.Row="1">
                        <StackPanel>
                            <Border Classes="switch-row" BorderThickness="0,0,0,1">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel>
                                        <TextBlock Classes="switch-title" Text="关闭窗口后保持 DSH Runtime" />
                                        <TextBlock Classes="switch-desc" Text="开启后关窗不杀 Runtime 进程；当前版本下次启动仍会重建会话（重接管尚未实现）" />
                                    </StackPanel>
                                    <ToggleSwitch
                                        Classes="switch"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Click="OnKeepRuntimeOnCloseToggled"
                                        IsChecked="{Binding KeepRuntimeOnClose}" />
                                </Grid>
                            </Border>
                            <Border Classes="switch-row" BorderThickness="0,0,0,1">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel>
                                        <TextBlock Classes="switch-title" Text="异常启动自动进入安全模式" />
                                        <TextBlock Classes="switch-desc" Text="连续启动失败后暂时禁用第三方插件" />
                                    </StackPanel>
                                    <ToggleSwitch
                                        Classes="switch"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Click="OnAutoSafeModeOnFailureToggled"
                                        IsChecked="{Binding AutoSafeModeOnFailure}" />
                                </Grid>
                            </Border>
                            <Border Classes="switch-row">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel>
                                        <TextBlock Classes="switch-title" Text="启动时检查网络更新" />
                                        <TextBlock
                                            Classes="switch-desc"
                                            Foreground="{DynamicResource DshWarnBrush}"
                                            Text="建议关闭：更新检查应在 UI 就绪后异步执行" />
                                    </StackPanel>
                                    <ToggleSwitch
                                        Classes="switch"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Click="OnCheckUpdatesOnStartupToggled"
                                        IsChecked="{Binding CheckUpdatesOnStartup}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
