<UserControl
    x:Class="DshDesktop.Presentation.Avalonia.Features.Updates.UpdatesView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:DshDesktop.Presentation.Avalonia.Features.Updates"
    xmlns:u="clr-namespace:DshDesktop.Domain.Updates;assembly=DshDesktop.Domain"
    xmlns:vm="clr-namespace:DshDesktop.Presentation.Avalonia.Features.Updates"
    x:DataType="vm:UpdatesViewModel">
    <ScrollViewer>
        <StackPanel Margin="24" Spacing="16">

            <!-- 顶部工具条（间距由根 StackPanel Spacing=16 承担；原 Classes="bar" 命不中任何选择器，已清） -->
            <DockPanel LastChildFill="False">
                <TextBlock
                    DockPanel.Dock="Left"
                    VerticalAlignment="Center"
                    Classes="panel-sub"
                    Text="{Binding Status}" />
                <Button
                    DockPanel.Dock="Right"
                    Classes="btn secondary"
                    Command="{Binding CheckUpdatesCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Path Classes="icon icon-sm" Data="{DynamicResource IconRefresh}" Stroke="{Binding $parent[Button].Foreground}" />
                        <TextBlock Text="检查更新" />
                    </StackPanel>
                </Button>
            </DockPanel>

            <TextBlock
                Foreground="{DynamicResource DshWarnBrush}"
                FontSize="{DynamicResource DshFontSizeSmall}"
                Text="{Binding PendingOperation}" />
            <!-- 仅在 Desktop 下载存在真实百分比时出现；其余更新操作由壳遮罩的旋转图标承载，
                 不在这里退化为来回扫的不确定进度条（2026-09-15 实机投诉）。 -->
            <ProgressBar
                Classes="bar"
                Margin="0,4,0,0"
                HorizontalAlignment="Stretch"
                IsVisible="{Binding DesktopDownloadProgress, Converter={x:Static local:Converters.IsNotNull}}"
                Value="{Binding DesktopDownloadProgress, FallbackValue=0}" />
            <TextBlock
                Foreground="{DynamicResource DshErrBrush}"
                FontSize="{DynamicResource DshFontSizeSmall}"
                Text="{Binding LastError}"
                TextWrapping="Wrap" />

            <!-- 两张对比卡 -->
            <Grid ColumnDefinitions="*,*">
                <Border Classes="panel" Grid.Column="0" Margin="0,0,8,0">
                    <StackPanel>
                        <Border Classes="panel-head">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="panel-title" Text="Desktop 本体" />
                                <Border
                                    Classes="tag ok"
                                    Grid.Column="1"
                                    IsVisible="{Binding LatestDesktopVersion, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                                    <TextBlock Text="已是最新" />
                                </Border>
                            </Grid>
                        </Border>
                        <Border Classes="panel-body">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="24"
                                        FontWeight="SemiBold"
                                        FontFamily="Geist Mono, Cascadia Code, Consolas"
                                        Text="{Binding DesktopVersion, StringFormat='v{0}'}" />
                                    <Border Classes="tag">
                                        <TextBlock Text="Stable" />
                                    </Border>
                                </StackPanel>
                                <TextBlock
                                    Classes="panel-sub"
                                    Text="自更新经 GitHub Releases 检查。更新时下载安装包、请求管理员权限覆盖安装，不触碰数据目录。" />
                                <Button
                                    Classes="btn primary"
                                    HorizontalAlignment="Left"
                                    Command="{Binding DownloadAndApplyDesktopUpdateCommand}"
                                    IsVisible="{Binding LatestDesktopVersion, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Path Classes="icon icon-sm" Data="{DynamicResource IconDownload}" Stroke="{Binding $parent[Button].Foreground}" />
                                        <TextBlock Text="下载并重启更新" />
                                    </StackPanel>
                                </Button>
                                <TextBlock
                                    Classes="panel-sub"
                                    TextWrapping="Wrap"
                                    Text="已开启「设置 → 更新策略 → 自动下载安装」时，更新包会在后台提前下好，点击此处将直接安装；若仍在下载中，会自动等待其完成后安装。" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Classes="panel" Grid.Column="1" Margin="8,0,0,0">
                    <StackPanel>
                        <Border Classes="panel-head">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="panel-title" Text="DSH Runtime" />
                                <!-- badge 由 DshStage 三态驱动：禁止再裸绑 LatestDshVersion 非空
                                     （检查成功后该字段始终非空，曾导致已是最新仍显示有可用更新）。 -->
                                <Border
                                    Classes="tag ok"
                                    Grid.Column="1"
                                    IsVisible="{Binding DshStage, Converter={x:Static local:Converters.EnumEquals}, ConverterParameter=UpToDate}">
                                    <TextBlock Text="已是最新" />
                                </Border>
                                <Border
                                    Classes="tag accent"
                                    Grid.Column="1"
                                    IsVisible="{Binding DshStage, Converter={x:Static local:Converters.EnumEquals}, ConverterParameter=Available}">
                                    <TextBlock Text="有可用更新" />
                                </Border>
                                <Border
                                    Classes="tag accent"
                                    Grid.Column="1"
                                    IsVisible="{Binding DshStage, Converter={x:Static local:Converters.EnumEquals}, ConverterParameter=ReadyToActivate}">
                                    <TextBlock Text="待激活" />
                                </Border>
                            </Grid>
                        </Border>
                        <Border Classes="panel-body">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="24"
                                        FontWeight="SemiBold"
                                        FontFamily="Geist Mono, Cascadia Code, Consolas"
                                        Foreground="{DynamicResource DshText3Brush}"
                                        Text="{Binding CurrentDshVersion, StringFormat='v{0}', FallbackValue='v—', TargetNullValue='v—'}" />
                                    <Path Classes="icon" Data="{DynamicResource IconChevronRight}" Stroke="{DynamicResource DshText4Brush}" />
                                    <TextBlock
                                        FontSize="24"
                                        FontWeight="SemiBold"
                                        FontFamily="Geist Mono, Cascadia Code, Consolas"
                                        Foreground="{DynamicResource DshAccentHiBrush}"
                                        Text="{Binding LatestDshVersion, StringFormat='v{0}', FallbackValue='v—', TargetNullValue='v—'}" />
                                    <Border Classes="tag mono">
                                        <TextBlock Text="latest" />
                                    </Border>
                                </StackPanel>
                                <TextBlock
                                    Classes="panel-sub"
                                    Text="{Binding LatestDshVersion, StringFormat='最新（{0} 通道）', FallbackValue='最新：—', TargetNullValue='最新：—'}" />
                                <TextBlock
                                    Classes="panel-sub"
                                    IsVisible="{Binding DshStage, Converter={x:Static local:Converters.EnumEquals}, ConverterParameter=ReadyToActivate}"
                                    Text="已下载到本机，激活即切换并重启" />
                                <Button
                                    Classes="btn primary"
                                    HorizontalAlignment="Left"
                                    Click="OnInstallLatestClicked"
                                    IsVisible="{Binding DshStage, Converter={x:Static local:Converters.EnumEquals}, ConverterParameter=Available}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Path Classes="icon icon-sm" Data="{DynamicResource IconDownload}" Stroke="{Binding $parent[Button].Foreground}" />
                                        <TextBlock Text="安装最新版本" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Classes="btn primary"
                                    HorizontalAlignment="Left"
                                    Click="OnActivateLatestClicked"
                                    IsVisible="{Binding DshStage, Converter={x:Static local:Converters.EnumEquals}, ConverterParameter=ReadyToActivate}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Path Classes="icon icon-sm" Data="{DynamicResource IconChevronRight}" Stroke="{Binding $parent[Button].Foreground}" />
                                        <TextBlock Text="激活并切换" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 两栏：可用 Runtime / 插件更新 -->
            <Grid ColumnDefinitions="*,*">
                <Border Classes="panel" Grid.Column="0" Margin="0,0,8,0">
                    <StackPanel>
                        <Border Classes="panel-head">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="panel-title" Text="可用 Runtime" />
                                <TextBlock Classes="panel-sub" Grid.Column="1" Text="激活即切换并重启" />
                            </Grid>
                        </Border>
                        <Border Classes="panel-body">
                            <ItemsControl ItemsSource="{Binding Runtimes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="u:DshRuntimeInfo">
                                        <Border Classes="path-row">
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <TextBlock
                                                    Width="160"
                                                    VerticalAlignment="Center"
                                                    FontFamily="Geist Mono, Cascadia Code, Consolas"
                                                    Text="{Binding Version}" />
                                                <Border Classes="tag accent" IsVisible="{Binding IsActive}">
                                                    <TextBlock Text="当前" />
                                                </Border>
                                                <Border Classes="tag" IsVisible="{Binding IsBorrowed}">
                                                    <TextBlock Text="借用" />
                                                </Border>
                                                <Border Classes="tag" IsVisible="{Binding Converter={x:Static local:Converters.LocalCopy}}">
                                                    <TextBlock Text="本机副本" />
                                                </Border>
                                                <Button
                                                    Classes="btn secondary sm"
                                                    HorizontalAlignment="Right"
                                                    Click="OnActivateRuntimeClicked"
                                                    Content="激活"
                                                    IsVisible="{Binding !IsActive}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Classes="panel" Grid.Column="1" Margin="8,0,0,0">
                    <StackPanel>
                        <Border Classes="panel-head">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="panel-title" Text="插件更新" />
                                <Border Classes="tag mono" Grid.Column="1">
                                    <TextBlock Text="{Binding PluginUpdates.Count}" />
                                </Border>
                            </Grid>
                        </Border>
                        <Border Classes="panel-body">
                            <ItemsControl ItemsSource="{Binding PluginUpdates}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="u:PluginUpdateInfo">
                                        <Border Classes="path-row">
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <TextBlock
                                                    Width="200"
                                                    Classes="plugin-name"
                                                    FontSize="{DynamicResource DshFontSizeBodySmall}"
                                                    Text="{Binding Name}" />
                                                <TextBlock
                                                    Width="110"
                                                    VerticalAlignment="Center"
                                                    FontFamily="Geist Mono, Cascadia Code, Consolas"
                                                    Foreground="{DynamicResource DshText3Brush}"
                                                    Text="{Binding CurrentVersion}" />
                                                <Path Classes="icon icon-sm" Data="{DynamicResource IconChevronRight}" Stroke="{DynamicResource DshText4Brush}" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontFamily="Geist Mono, Cascadia Code, Consolas"
                                                    Foreground="{DynamicResource DshAccentHiBrush}"
                                                    Text="{Binding LatestVersion}" />
                                                <Button
                                                    Classes="btn secondary sm"
                                                    HorizontalAlignment="Right"
                                                    Click="OnUpdatePluginClicked"
                                                    Content="更新" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
