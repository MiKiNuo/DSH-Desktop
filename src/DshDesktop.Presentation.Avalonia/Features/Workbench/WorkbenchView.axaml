<UserControl
    x:Class="DshDesktop.Presentation.Avalonia.Features.Workbench.WorkbenchView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:DshDesktop.Presentation.Avalonia.Features.Workbench"
    xmlns:web="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.WebView"
    x:DataType="vm:WorkbenchViewModel">
    <!--
      Workbench 页（Phase 8 Issue 06，视觉基准 docs/DSH-Desktop-UI-Redesign.html #p-workbench）：
      用户精简后本页只保留内容区——WebView 铺满，外加启动加载框。
      工具条（后退/前进/刷新）、端口标记、页内错误条已移除，见 §21 Phase 6 修订注。

      🚨 NativeWebView 是 Win32 原生子窗口宿主。Avalonia 官方 native-interop 文档的 airspace
      约束：原生视图永远渲染在 Avalonia 内容之上，任何 Avalonia 遮罩都盖不住它。
      所以加载期必须让两者互斥——WebView 初始隐藏，遮罩独占内容区；
      之后由 code-behind 按 DshUrl / 导航结果切换（守卫见 WorkbenchLoadingOverlayTests）。
    -->
    <Grid>
        <web:NativeWebView x:Name="WebViewHost" IsVisible="False" />
        <Border x:Name="LoadingOverlay" Background="{DynamicResource DshBgBrush}">
            <Border
                Classes="card"
                Width="320"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <StackPanel Margin="20,22">
                    <Panel Height="60">
                        <Path
                            x:Name="LoadingWhale"
                            Classes="whale"
                            Data="{DynamicResource IconWhale}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Panel>
                    <TextBlock
                        x:Name="LoadingTitle"
                        Classes="modal-title"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Center"
                        Text="正在启动 DSH 工作台…" />
                    <TextBlock
                        x:Name="LoadingHint"
                        Classes="modal-body"
                        HorizontalAlignment="Center"
                        Text="Runtime 就绪后自动载入界面" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
