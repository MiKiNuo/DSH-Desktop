<UserControl
    x:Class="DshDesktop.Presentation.Avalonia.Features.Diagnostics.DiagnosticsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:DshDesktop.Presentation.Avalonia.Features.Diagnostics"
    xmlns:local="clr-namespace:DshDesktop.Presentation.Avalonia.Features.Diagnostics"
    x:DataType="vm:DiagnosticsViewModel">
    <!--
      Diagnostics 页（Phase 8 Issue 06，视觉基准 docs/DSH-Desktop-UI-Redesign.html #p-diagnostics）：
      工具条（运行诊断 primary / 导出诊断包 secondary / 打开日志目录 ghost / 搜索 field）+ Live 控制台卡片
      （级别分段过滤 seg + 呼吸点 Live 标记 + 等宽日志 + log-ok/warn/err 着色 + 空状态）。
    -->
    <UserControl.Resources>
        <local:DiagnosticLevelConverter x:Key="DiagLevelConverter" />
    </UserControl.Resources>
    <DockPanel Margin="24">
        <Grid
            Classes="toolbar"
            DockPanel.Dock="Top"
            ColumnDefinitions="Auto,*,Auto"
            Margin="0">
            <StackPanel
                Grid.Column="0"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    Classes="btn primary"
                    Command="{Binding RunDiagnosisCommand}"
                    Content="运行诊断" />
                <Button
                    Classes="btn secondary"
                    Click="OnExportClicked"
                    Content="导出诊断包" />
                <Button
                    Classes="btn ghost"
                    Command="{Binding OpenLogsDirectoryCommand}"
                    Content="打开日志目录" />
            </StackPanel>
            <TextBox
                x:Name="SearchBox"
                Grid.Column="2"
                Classes="field"
                Width="240"
                PlaceholderText="过滤事件名或消息…"
                TextChanged="OnSearchChanged" />
        </Grid>

        <Border Classes="panel" DockPanel.Dock="Bottom">
            <Grid RowDefinitions="Auto,*">
                <Border Classes="panel-head" Grid.Row="0">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock Classes="panel-title" Text="实时诊断日志" />
                            <TextBlock Classes="panel-sub" Text="Runtime lifecycle · Health Check · Plugin load" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="10"
                            VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="0">
                                <Button
                                    x:Name="FilterAll"
                                    Classes="btn seg-first primary"
                                    Click="OnFilterClicked"
                                    Content="全部" />
                                <Button
                                    x:Name="FilterInfo"
                                    Classes="btn seg-mid"
                                    Click="OnFilterClicked"
                                    Content="INFO" />
                                <Button
                                    x:Name="FilterWarn"
                                    Classes="btn seg-mid"
                                    Click="OnFilterClicked"
                                    Content="WARN" />
                                <Button
                                    x:Name="FilterErr"
                                    Classes="btn seg-last"
                                    Click="OnFilterClicked"
                                    Content="ERROR" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Ellipse Classes="dot ok" Width="6" Height="6" />
                                <TextBlock
                                    Text="Live"
                                    FontSize="{DynamicResource DshFontSizeSmall}"
                                    Foreground="{DynamicResource DshText2Brush}"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Classes="panel-body" Grid.Row="1">
                    <StackPanel>
                        <Border Classes="console">
                            <ListBox x:Name="EntriesList" Classes="console">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DiagnosticRow">
                                        <Grid ColumnDefinitions="92,48,*">
                                            <TextBlock Classes="log-ts" Text="{Binding TimestampText}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Classes="log-level"
                                                Text="{Binding Converter={StaticResource DiagLevelConverter}}" />
                                            <TextBlock
                                                Grid.Column="2"
                                                Classes="log-line"
                                                Classes.log-ok="{Binding IsOk}"
                                                Classes.log-warn="{Binding IsWarning}"
                                                Classes.log-err="{Binding IsError}"
                                                Text="{Binding Message}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                        <Border x:Name="EmptyState" Classes="empty" IsVisible="False">
                            <StackPanel>
                                <TextBlock Classes="empty-title" Text="没有匹配的事件" />
                                <TextBlock Classes="empty-sub" Text="调整级别筛选或清空关键词" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
