<UserControl
    x:Class="DshDesktop.Presentation.Avalonia.Features.Plugins.PluginsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:DshDesktop.Presentation.Avalonia.Features.Plugins"
    x:DataType="vm:PluginsViewModel">
    <!--
      Plugins 页（Phase 8 Issue 06，视觉基准 docs/DSH-Desktop-UI-Prototype.html plugins section 170-186 行）：
      工具条（搜索 .search 客户端过滤 / 刷新 / 安装插件 primary）+ 卡片（头部标题+副标题+总数 tag，
      表格列：插件 / 状态 tag / 版本 / 加载耗时恒 "—" / 操作右对齐）；安装事务进度（§20）融入卡片。
    -->
    <ScrollViewer>
        <StackPanel Margin="24">
            <StackPanel Classes="toolbar" Orientation="Horizontal">
                <TextBox
                    x:Name="SearchInput"
                    Classes="search"
                    TextChanged="OnSearchTextChanged"
                    PlaceholderText="搜索已安装插件…" />
                <Button
                    Classes="btn"
                    Command="{Binding LoadPluginsCommand}"
                    Content="刷新" />
                <Button
                    Classes="btn primary"
                    Click="OnInstallClicked"
                    Content="安装插件" />
            </StackPanel>

            <Border Classes="card">
                <Grid RowDefinitions="Auto,*">
                    <Border Classes="card-head" Grid.Row="0">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                                <TextBlock Classes="card-title" Text="已安装插件" />
                                <TextBlock Classes="card-subtitle" Text="插件位于 data/dsh-home/profiles/web/node_modules" />
                            </StackPanel>
                            <Border Classes="tag info" Grid.Column="1">
                                <TextBlock x:Name="CountTag" Text="0 Plugins" />
                            </Border>
                        </Grid>
                    </Border>
                    <Border Classes="card-body" Grid.Row="1">
                        <StackPanel Spacing="10">
                            <TextBox
                                x:Name="InstallSourceInput"
                                Classes="search"
                                MaxWidth="520"
                                HorizontalAlignment="Left"
                                PlaceholderText="安装来源：npm 包名（可带版本）或本地 .tgz 路径，填好后点上方安装插件" />
                            <TextBlock
                                Foreground="{DynamicResource DshYellowBrush}"
                                FontSize="{DynamicResource DshFontSizeSmall}"
                                Text="{Binding PendingOperation}" />
                            <TextBlock
                                Foreground="{DynamicResource DshRedBrush}"
                                FontSize="{DynamicResource DshFontSizeSmall}"
                                Text="{Binding LastError}"
                                TextWrapping="Wrap" />

                            <StackPanel>
                                <Border Classes="table-head">
                                    <Grid ColumnDefinitions="*,110,90,90,160">
                                        <TextBlock Classes="table-head" Margin="12,0,0,0" Text="插件" />
                                        <TextBlock Classes="table-head" Grid.Column="1" Text="状态" />
                                        <TextBlock Classes="table-head" Grid.Column="2" Text="版本" />
                                        <TextBlock Classes="table-head" Grid.Column="3" Text="加载耗时" />
                                        <TextBlock
                                            Classes="table-head"
                                            Grid.Column="4"
                                            Margin="0,0,12,0"
                                            HorizontalAlignment="Right"
                                            Text="操作" />
                                    </Grid>
                                </Border>
                                <ItemsControl x:Name="Rows">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PluginRow">
                                            <Border Classes="table-row">
                                                <Grid ColumnDefinitions="*,110,90,90,160">
                                                    <StackPanel Margin="12,0,0,0">
                                                        <TextBlock Classes="plugin-name" Text="{Binding Name}" />
                                                        <TextBlock
                                                            Foreground="{DynamicResource DshMuted2Brush}"
                                                            FontSize="{DynamicResource DshFontSizeCaption}"
                                                            Text="{Binding Description}" />
                                                    </StackPanel>
                                                    <Border
                                                        Classes="tag"
                                                        Classes.info="{Binding StatusIsInfo}"
                                                        Classes.warn="{Binding StatusIsWarn}"
                                                        Grid.Column="1"
                                                        HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding StatusText}" />
                                                    </Border>
                                                    <TextBlock
                                                        Classes="table-cell"
                                                        Grid.Column="2"
                                                        Text="{Binding Version}" />
                                                    <!-- DSH 无插件加载耗时数据，列保留为原型视觉（Phase 8 spec Round 2 Q2） -->
                                                    <TextBlock
                                                        Classes="table-cell"
                                                        Grid.Column="3"
                                                        Text="{Binding LoadTime}" />
                                                    <StackPanel
                                                        Grid.Column="4"
                                                        Margin="0,0,12,0"
                                                        HorizontalAlignment="Right"
                                                        Orientation="Horizontal"
                                                        Spacing="6">
                                                        <Button
                                                            Classes="btn small"
                                                            Click="OnUpdateClicked"
                                                            Content="更新"
                                                            IsVisible="{Binding ShowUpdate}" />
                                                        <Button
                                                            Classes="btn small"
                                                            Click="OnEnableClicked"
                                                            Content="启用"
                                                            IsVisible="{Binding ShowEnable}" />
                                                        <Button
                                                            Classes="btn small"
                                                            Click="OnDisableClicked"
                                                            Content="禁用"
                                                            IsVisible="{Binding ShowManage}" />
                                                        <Button
                                                            Classes="btn small danger"
                                                            Click="OnUninstallClicked"
                                                            Content="卸载"
                                                            IsVisible="{Binding ShowManage}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
