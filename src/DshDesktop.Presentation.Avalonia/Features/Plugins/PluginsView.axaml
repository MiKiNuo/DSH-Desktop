<UserControl
    x:Class="DshDesktop.Presentation.Avalonia.Features.Plugins.PluginsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:p="clr-namespace:DshDesktop.Domain.Plugins;assembly=DshDesktop.Domain"
    xmlns:vm="clr-namespace:DshDesktop.Presentation.Avalonia.Features.Plugins"
    x:DataType="vm:PluginsViewModel">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="16,12">
            <StackPanel Spacing="8">
                <TextBlock
                    FontSize="22"
                    FontWeight="SemiBold"
                    Text="Plugins" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox
                        x:Name="InstallSourceInput"
                        Width="380"
                        PlaceholderText="npm 包名（可带版本）或本地 .tgz 路径" />
                    <Button Click="OnInstallClicked" Content="安装" />
                    <Button Command="{Binding DisableAllThirdPartyCommand}" Content="全禁第三方并启动" />
                </StackPanel>
                <TextBlock
                    Foreground="#EAB308"
                    Text="{Binding PendingOperation}" />
                <TextBlock
                    Foreground="#EF4444"
                    Text="{Binding LastError}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <ListBox Padding="16,0" ItemsSource="{Binding Plugins}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="p:PluginInfo">
                    <Border
                        Margin="0,4"
                        Padding="12,8"
                        BorderBrush="#30363D"
                        BorderThickness="1"
                        CornerRadius="6">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Name}" />
                                <Border
                                    VerticalAlignment="Center"
                                    Background="#1F6FEB"
                                    CornerRadius="4"
                                    Padding="6,1"
                                    IsVisible="{Binding IsCore}">
                                    <TextBlock FontSize="11" Foreground="White" Text="官方" />
                                </Border>
                            </StackPanel>
                            <TextBlock
                                Grid.Column="1"
                                Margin="12,0"
                                VerticalAlignment="Center"
                                Foreground="#9AA4B2"
                                Text="{Binding Version}" />
                            <ToggleSwitch
                                Grid.Column="2"
                                Margin="12,0"
                                VerticalAlignment="Center"
                                Click="OnToggleClicked"
                                IsChecked="{Binding Enabled}"
                                IsEnabled="{Binding !IsCore}" />
                            <Button
                                Grid.Column="3"
                                VerticalAlignment="Center"
                                Click="OnUninstallClicked"
                                Content="卸载"
                                IsVisible="{Binding !IsCore}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
