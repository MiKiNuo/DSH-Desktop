<!--
  DSH Desktop 暗色主题（UI 重设计 · 中性石墨 + 单一强调色）。
  命名与数值严格遵循 docs/UI-Redesign-Token-Contract.md §1-§5；
  视觉参数逐条来自 docs/DSH-Desktop-UI-Redesign.html 的 <style> :root 与组件样式。
  颜色 / 字号 / 圆角集中在本字典，各 Feature 视图按 Classes 引用，禁止散落硬编码。
  豁免：构造期需要的画刷走 RuntimeLifecycleBrushes（构造期 View 未挂逻辑树，
  TryFindResource 走不到本字典——运行时实测崩溃，故该文件用 Color.Parse 同值常量）。
  不在本轮范围：命令面板、明暗双主题（契约 §8）。
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <!-- ===== 中性基色（契约 §1） ===== -->
        <SolidColorBrush x:Key="DshBgBrush" Color="#0a0b0d" />
        <SolidColorBrush x:Key="DshSurface1Brush" Color="#111214" />
        <SolidColorBrush x:Key="DshSurface2Brush" Color="#16181b" />
        <SolidColorBrush x:Key="DshSurface3Brush" Color="#1d2024" />
        <SolidColorBrush x:Key="DshSurface4Brush" Color="#24282d" />
        <SolidColorBrush x:Key="DshLineBrush" Color="#282c32" />
        <SolidColorBrush x:Key="DshLineSoftBrush" Color="#1e2126" />

        <!-- ===== 文字 ===== -->
        <SolidColorBrush x:Key="DshTextBrush" Color="#edeef0" />
        <SolidColorBrush x:Key="DshText2Brush" Color="#a1a7b0" />
        <SolidColorBrush x:Key="DshText3Brush" Color="#6d737c" />
        <SolidColorBrush x:Key="DshText4Brush" Color="#4a4f57" />

        <!-- ===== 强调（唯一强调色） ===== -->
        <SolidColorBrush x:Key="DshAccentBrush" Color="#5b7cfa" />
        <SolidColorBrush x:Key="DshAccentHiBrush" Color="#6d8bff" />
        <SolidColorBrush x:Key="DshAccentLoBrush" Color="#3f5fd6" />
        <SolidColorBrush x:Key="DshAccentSoftBrush" Color="#1C5B7CFA" />
        <SolidColorBrush x:Key="DshAccentLineBrush" Color="#525B7CFA" />
        <SolidColorBrush x:Key="DshOnAccentBrush" Color="#ffffff" />

        <!-- ===== 语义 ===== -->
        <SolidColorBrush x:Key="DshOkBrush" Color="#3fbf8f" />
        <SolidColorBrush x:Key="DshOkSoftBrush" Color="#1C3FBF8F" />
        <SolidColorBrush x:Key="DshOkLineBrush" Color="#473FBF8F" />
        <SolidColorBrush x:Key="DshWarnBrush" Color="#e0a93f" />
        <SolidColorBrush x:Key="DshWarnSoftBrush" Color="#1CE0A93F" />
        <SolidColorBrush x:Key="DshWarnLineBrush" Color="#47E0A93F" />
        <SolidColorBrush x:Key="DshErrBrush" Color="#ec625d" />
        <SolidColorBrush x:Key="DshErrSoftBrush" Color="#1CEC625D" />
        <SolidColorBrush x:Key="DshErrLineBrush" Color="#4CEC625D" />

        <!-- ===== 浮层 ===== -->
        <SolidColorBrush x:Key="DshScrimBrush" Color="#9E05060A" />

        <!-- ===== 字号（契约 §2） ===== -->
        <x:Double x:Key="DshFontSizeCaption">10</x:Double>
        <x:Double x:Key="DshFontSizeSmall">11</x:Double>
        <x:Double x:Key="DshFontSizeBodySmall">12</x:Double>
        <x:Double x:Key="DshFontSizeBody">13</x:Double>
        <x:Double x:Key="DshFontSizeTitle">14.5</x:Double>
        <x:Double x:Key="DshFontSizeHero">19</x:Double>

        <!-- ===== 圆角（契约 §3） ===== -->
        <CornerRadius x:Key="DshRadiusBadge">6</CornerRadius>
        <CornerRadius x:Key="DshRadiusSmall">8</CornerRadius>
        <CornerRadius x:Key="DshRadiusMedium">10</CornerRadius>
        <CornerRadius x:Key="DshRadiusCard">14</CornerRadius>
    </Styles.Resources>

    <!-- ===== 全局基底：背景 / 前景 / 字体（Window 级设置，靠属性继承下传） ===== -->
    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource DshBgBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DshTextBrush}" />
        <Setter Property="FontFamily" Value="Geist, Segoe UI Variable Display, Segoe UI, Microsoft YaHei" />
        <Setter Property="FontSize" Value="{DynamicResource DshFontSizeBody}" />
    </Style>

    <!-- ===== 图标（契约 §6：用 Path + Data，不用 PathIcon） ===== -->
    <Style Selector="Path.icon">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Stroke" Value="{DynamicResource DshText3Brush}" />
        <Setter Property="StrokeThickness" Value="1.6" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeJoin" Value="Round" />
        <Setter Property="Fill" Value="Transparent" />
        <Setter Property="Stretch" Value="Uniform" />
    </Style>
    <Style Selector="Path.icon.icon-sm">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
    </Style>
    <Style Selector="Path.icon.icon-lg">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
    </Style>

    <!-- ============================================================
         壳层：侧栏 / 顶栏 / 状态栏 / 导航
         ============================================================ -->
    <Style Selector="Border.sidebar">
        <Setter Property="Background" Value="{DynamicResource DshSurface1Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DshLineSoftBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="Padding" Value="12,14" />
    </Style>

    <!-- 品牌行 = 折叠开关：整行可点（Phase 9 修订），内容左右铺满 -->
    <Style Selector="Button.brand">
        <Setter Property="BorderBrush" Value="{DynamicResource DshLineSoftBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Height" Value="56" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.brand:pointerover">
        <Setter Property="Background" Value="{DynamicResource DshSurface2Brush}" />
    </Style>
    <Style Selector="Border.brand-mark">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background">
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#6d8bff" Offset="0" />
                <GradientStop Color="#3f5fd6" Offset="1" />
            </LinearGradientBrush>
        </Setter>
    </Style>
    <Style Selector="TextBlock.brand-mark-text">
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.brand-title">
        <Setter Property="FontSize" Value="{DynamicResource DshFontSizeBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.brand-sub">
        <Setter Property="Foreground" Value="{DynamicResource DshText3Brush}" />
        <Setter Property="FontSize" Value="{DynamicResource DshFontSizeSmall}" />
    </Style>

    <Style Selector="TextBlock.nav-label">
        <Setter Property="Padding" Value="16,6,8,7" />
        <Setter Property="Foreground" Value="{DynamicResource DshText4Brush}" />
        <Setter Property="FontSize" Value="{DynamicResource DshFontSizeCaption}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="Button.nav-btn">
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Margin" Value="0,0,0,3" />
        <Setter Property="CornerRadius" Value="{DynamicResource DshRadiusSmall}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource DshText2Brush}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="FontSize" Value="{DynamicResource DshFontSizeBody}" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="Button.nav-btn:pointerover">
        <Setter Property="Background" Value="{DynamicResource DshSurface3Brush}" />
        <Setter Property="Foreground" Value="{DynamicResource DshTextBrush}" />
    </Style>
    <Style Selector="Button.nav-btn.active">
        <Setter Property="Background" Value="{DynamicResource DshAccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DshAccentLineBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DshAccentHiBrush}" />
    </Style>
    <Style Selector="TextBlock.nav-icon">
        <Setter Property="Width" Value="20" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- 折叠态：图标居中 -->
    <Style Selector="Button.nav-btn.collapsed">
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.nav-badge">
        <Setter Property="MinWidth" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Padding" Value="5,0" />
        <Setter Property="CornerRadius" Value="{DynamicResource DshRadiusBadge}" />
        <Setter Property="Background" Value="{DynamicResource DshAccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DshAccentLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.nav-badge TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource DshAccentHiBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource DshFontSizeSmall}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.runtime-mini">
        <Setter Property="BorderBrush" Value="{DynamicResource DshLineSoftBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource DshSurface2Brush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource DshRadiusMedium}" />
        <Setter Property="Padding" Value="11" />
    </Style>
    <Style Selector="TextBlock.runtime-mini-text">
        <Setter Property="Foreground" Value="{DynamicResource DshText2Brush}" />
        <Setter Property="FontSize" Value="{DynamicResource DshFontSizeSmall}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 顶栏（cmdbar） -->
    <Style Selector="Border.topbar">
        <Setter Property="Height" Value="52" />
        <Setter Property="BorderBrush" Value="{DynamicResource DshLineSoftBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Background" Value="{DynamicResource DshSurface1Brush}" />
        <Setter Property="Padding" Value="20,0" />
    </Style>
    <Style Selector="TextBlock.page-title">
        <Setter Property="FontSize" Value="{DynamicResource DshFontSizeTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.page-desc">
        <Setter Property="Foreground" Value="{DynamicResource DshText3Brush}" />
        <Setter Property="FontSize" Value="{DynamicResource DshFontSizeBodySmall}" />
        <Setter Property="Margin" Value="10,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 状态栏 -->
    <Style Selector="Border.statusbar">
        <Setter Property="Height" Value="28" />
        <Setter Property="BorderBrush" Value="{DynamicResource DshLineSoftBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Background" Value="{DynamicResource DshSurface1Brush}" />
        <Setter Property="Padding" Value="14,0" />
    </Style>
    <Style Selector="TextBlock.statusbar-text">
        <Setter Property="Foreground" Value="{DynamicResource DshText3Brush}" />
        <Setter Property="FontSize" Value="{DynamicResource DshFontSizeSmall}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ============================================================
         按钮系统：4 层级 × 3 尺寸 + seg + 统一状态
         ============================================================ -->
    <Style Selector="Button.btn">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="CornerRadius" Value="{DynamicResource DshRadiusSmall}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource DshLineBrush}" />
        <Setter Property="Background" Value="{DynamicResource DshSurface2Brush}" />
        <Setter Property="Foreground" Value="{DynamicResource DshTextBrush}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontSize" Value="{DynamicResource DshFontSizeBodySmall}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.btn:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource DshText4Brush}" />
        <Setter Property="Background" Value="{DynamicResource DshSurface3Brush}" />
    </Style>
    <Style Selector="Button.btn:pressed">
        <Setter Property="RenderTransform">
            <TranslateTransform Y="1" />
        </Setter>
    </Style>
    <Style Selector="Button.btn:disabled">
        <Setter Property="Opacity" Value="0.38" />
    </Style>
    <Style Selector="Button.btn:focus-visible">
        <Setter Property="BorderBrush" Value="{DynamicResource DshAccentLineBrush}" />
    </Style>

    <Style Selector="Button.btn.primary">
        <Setter Property="Background" Value="{DynamicResource DshAccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DshAccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DshOnAccentBrush}" />
    </Style>
    <Style Selector="Button.btn.primary:pointerover">
        <Setter Property="Background" Value="{DynamicResource DshAccentHiBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DshAccentHiBrush}" />
    </Style>

    <Style Selector="Button.btn.secondary">
        <Setter Property="Background" Value="{DynamicResource DshSurface2Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DshLineBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DshTextBrush}" />
    </Style>
    <Style Selector="Button.btn.secondary:pointerover">
        <Setter Property="Background" Value="{DynamicResource DshSurface3Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DshText4Brush}" />
    </Style>

    <Style Selector="Button.btn.ghost">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource DshText2Brush}" />
    </Style>
    <Style Selector="Button.btn.ghost:pointerover">
        <Setter Property="Background" Value="{DynamicResource DshSurface3Brush}" />
        <Setter Property="Foreground" Value="{DynamicResource DshTextBrush}" />
    </Style>

    <Style Selector="Button.btn.danger">
        <Setter Property="Background" Value="{DynamicResource DshErrSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DshErrLineBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DshErrBrush}" />
    </Style>
    <Style Selector="Button.btn.danger:pointerover">
        <Setter Property="Background" Value="{DynamicResource DshErrBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DshErrBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DshOnAccentBrush}" />
    </Style>

    <Style Selector="Button.btn.lg">
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="FontSize" Value="{DynamicResource DshFontSizeBody}" />
    </Style>
    <Style Selector="Button.btn.sm">
        <Setter Property="MinHeight" Value="27" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="FontSize" Value="{DynamicResource DshFontSizeSmall}" />
    </Style>
    <!-- 分段控件：相邻按钮共享边框（左/中/右圆角）。Workbench 工具条已移除，
         现由 Diagnostics（级别筛选）与 Plugins（状态过滤）消费。 -->
    <Style Selector="Button.btn.seg-first">
        <Setter Property="CornerRadius" Value="8,0,0,8" />
        <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="Button.btn.seg-mid">
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Margin" Value="-1,0,0,0" />
    </Style>
    <Style Selector="Button.btn.seg-last">
        <Setter Property="CornerRadius" Value="0,8,8,0" />
        <Setter Property="Margin" Value="-1,0,0,0" />
    </Style>
    <Style Selector="Button.btn.seg-first.seg-last">
        <Setter Property="CornerRadius" Value="{DynamicResource DshRadiusSmall}" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <!-- ============================================================
         面板（契约 §5：panel 系列；card 系列为兼容别名，
         现有 Dashboard/Plugins/Settings 视图仍用 Classes="card*"，待后续代理重排）
         ============================================================ -->
    <Style Selector="Border.panel">
        <Setter Property="Background" Value="{DynamicResource DshSurface1Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DshLineSoftBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource DshRadiusCard}" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.panel-head">
        <Setter Property="Padding" Value="16,13" />
        <Setter Property="BorderBrush" Value="{DynamicResource DshLineSoftBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="Border.panel-body">
        <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="TextBlock.panel-title">
        <Setter Property="FontSize" Value="{DynamicResource DshFontSizeBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.panel-sub">
        <Setter Property="FontSize" Value="{DynamicResource DshFontSizeBodySmall}" />
        <Setter Property="Foreground" Value="{DynamicResource DshText3Brush}" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource DshSurface1Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DshLineSoftBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource DshRadiusCard}" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.card-head">
        <Setter Property="Padding" Value="16,13" />
        <Setter Property="BorderBrush" Value="{DynamicResource DshLineSoftBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="TextBlock.card-title">
        <Setter Property="FontSize" Value="{DynamicResource DshFontSizeBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.card-subtitle">
        <Setter Property="FontSize" Value="{DynamicResource DshFontSizeBodySmall}" />
        <Setter Property="Foreground" Value="{DynamicResource DshText3Brush}" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
    <Style Selector="Border.card-body">
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style Selector="TextBlock.eyebrow">
        <Setter Property="Foreground" Value="{DynamicResource DshText4Brush}" />
        <Setter Property="FontSize" Value="{DynamicResource DshFontSizeCaption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="1" />
    </Style>

    <!-- ============================================================
         标签
         ============================================================ -->
    <Style Selector="Border.tag">
        <Setter Property="Height" Value="20" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="CornerRadius" Value="{DynamicResource DshRadiusBadge}" />
        <Setter Property="Background" Value="{DynamicResource DshSurface2Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DshLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.tag TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource DshText2Brush}" />
        <Setter Property="FontSize" Value="{DynamicResource DshFontSizeCaption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.tag.ok">
        <Setter Property="Background" Value="{DynamicResource DshOkSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DshOkLineBrush}" />
    </Style>
    <Style Selector="Border.tag.ok TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource DshOkBrush}" />
    </Style>
    <Style Selector="Border.tag.accent">
        <Setter Property="Background" Value="{DynamicResource DshAccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DshAccentLineBrush}" />
    </Style>
    <Style Selector="Border.tag.accent TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource DshAccentHiBrush}" />
    </Style>
    <Style Selector="Border.tag.mono TextBlock">
        <Setter Property="FontFamily" Value="Geist Mono, Cascadia Code, Consolas" />
    </Style>
    <!-- 兼容别名：旧视图用 Classes="tag info"（info = 蓝/强调） -->
    <Style Selector="Border.tag.info">
        <Setter Property="Background" Value="{DynamicResource DshAccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DshAccentLineBrush}" />
    </Style>
    <Style Selector="Border.tag.info TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource DshAccentHiBrush}" />
    </Style>

    <!-- ============================================================
         表单
         ============================================================ -->
    <Style Selector="TextBox.field">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="11,0" />
        <Setter Property="CornerRadius" Value="{DynamicResource DshRadiusSmall}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource DshLineBrush}" />
        <Setter Property="Background" Value="{DynamicResource DshSurface2Brush}" />
        <Setter Property="Foreground" Value="{DynamicResource DshTextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource DshTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.field:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource DshText4Brush}" />
    </Style>
    <Style Selector="TextBox.field:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource DshAccentLineBrush}" />
        <Setter Property="Background" Value="{DynamicResource DshSurface1Brush}" />
    </Style>
    <Style Selector="ComboBox.field">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="11,0" />
        <Setter Property="CornerRadius" Value="{DynamicResource DshRadiusSmall}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource DshLineBrush}" />
        <Setter Property="Background" Value="{DynamicResource DshSurface2Brush}" />
        <Setter Property="Foreground" Value="{DynamicResource DshTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ComboBox.field:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource DshText4Brush}" />
    </Style>
    <Style Selector="ComboBox.field:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource DshAccentLineBrush}" />
    </Style>
    <Style Selector="ComboBox.field:dropdownopen">
        <Setter Property="BorderBrush" Value="{DynamicResource DshAccentLineBrush}" />
    </Style>

    <!-- 开关：38x20 → 36x20 轨 + 16 滑块（模板由控件逻辑驱动位移） -->
    <Style Selector="ToggleSwitch.switch">
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    x:Name="Track"
                    Width="36"
                    Height="20"
                    Padding="2"
                    Background="{DynamicResource DshSurface4Brush}"
                    CornerRadius="10">
                    <Panel x:Name="PART_MovingKnobs" HorizontalAlignment="Left">
                        <Ellipse
                            x:Name="Thumb"
                            Width="16"
                            Height="16"
                            Fill="{DynamicResource DshText3Brush}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top" />
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ToggleSwitch.switch:checked /template/ Border#Track">
        <Setter Property="Background" Value="{DynamicResource DshAccentBrush}" />
    </Style>
    <Style Selector="ToggleSwitch.switch:checked /template/ Ellipse#Thumb">
        <Setter Property="Fill" Value="#ffffff" />
        <Setter Property="RenderTransform">
            <TranslateTransform X="16" Y="0" />
        </Setter>
    </Style>

    <!-- ============================================================
         状态点（呼吸动画）
         ============================================================ -->
    <Style Selector="Ellipse.dot">
        <Setter Property="Width" Value="7" />
        <Setter Property="Height" Value="7" />
        <Setter Property="Fill" Value="{DynamicResource DshText3Brush}" />
    </Style>
    <Style Selector="Ellipse.dot.ok">
        <Setter Property="Fill" Value="{DynamicResource DshOkBrush}" />
        <Style.Animations>
            <Animation Duration="0:0:2.6" IterationCount="Infinite" Easing="SineEaseInOut">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0.4" />
                </KeyFrame>
                <KeyFrame Cue="50%">
                    <Setter Property="Opacity" Value="1" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="0.4" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Ellipse.dot.warn">
        <Setter Property="Fill" Value="{DynamicResource DshWarnBrush}" />
    </Style>
    <Style Selector="Ellipse.dot.err">
        <Setter Property="Fill" Value="{DynamicResource DshErrBrush}" />
    </Style>
    <Style Selector="Ellipse.dot.idle">
        <Setter Property="Fill" Value="{DynamicResource DshText4Brush}" />
    </Style>

    <!-- ============================================================
         行式容器：kv / switch-row / path-row
         ============================================================ -->
    <Style Selector="Border.kv-row">
        <Setter Property="Padding" Value="0,9" />
        <Setter Property="BorderBrush" Value="{DynamicResource DshLineSoftBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>
    <Style Selector="TextBlock.kv-key">
        <Setter Property="Foreground" Value="{DynamicResource DshText3Brush}" />
        <Setter Property="FontSize" Value="{DynamicResource DshFontSizeBodySmall}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.kv-value">
        <Setter Property="Foreground" Value="{DynamicResource DshText2Brush}" />
        <Setter Property="FontSize" Value="{DynamicResource DshFontSizeBodySmall}" />
        <Setter Property="FontFamily" Value="Geist Mono, Cascadia Code, Consolas" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="Border.switch-row">
        <Setter Property="Padding" Value="0,13" />
        <Setter Property="BorderBrush" Value="{DynamicResource DshLineSoftBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>
    <Style Selector="TextBlock.switch-title">
        <Setter Property="FontSize" Value="{DynamicResource DshFontSizeBodySmall}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.switch-desc">
        <Setter Property="Foreground" Value="{DynamicResource DshText3Brush}" />
        <Setter Property="FontSize" Value="{DynamicResource DshFontSizeCaption}" />
        <Setter Property="Margin" Value="0,3,0,0" />
    </Style>

    <Style Selector="Border.path-row">
        <Setter Property="Padding" Value="0,11" />
        <Setter Property="BorderBrush" Value="{DynamicResource DshLineSoftBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>
    <Style Selector="TextBlock.path-key">
        <Setter Property="Width" Value="104" />
        <Setter Property="Foreground" Value="{DynamicResource DshText3Brush}" />
        <Setter Property="FontSize" Value="{DynamicResource DshFontSizeBodySmall}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.path-value">
        <Setter Property="Padding" Value="11,9" />
        <Setter Property="CornerRadius" Value="{DynamicResource DshRadiusBadge}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DshLineSoftBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource DshSurface2Brush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.path-value">
        <Setter Property="Foreground" Value="{DynamicResource DshText2Brush}" />
        <Setter Property="FontSize" Value="{DynamicResource DshFontSizeSmall}" />
        <Setter Property="FontFamily" Value="Geist Mono, Cascadia Code, Consolas" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- ============================================================
         表格
         ============================================================ -->
    <Style Selector="Border.table-head">
        <Setter Property="BorderBrush" Value="{DynamicResource DshLineSoftBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="0,10" />
    </Style>
    <Style Selector="TextBlock.table-head">
        <Setter Property="Foreground" Value="{DynamicResource DshText4Brush}" />
        <Setter Property="FontSize" Value="{DynamicResource DshFontSizeCaption}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.table-row">
        <Setter Property="BorderBrush" Value="{DynamicResource DshLineSoftBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="0,11" />
    </Style>
    <Style Selector="Border.table-row:pointerover">
        <Setter Property="Background" Value="{DynamicResource DshSurface2Brush}" />
    </Style>
    <Style Selector="TextBlock.table-cell">
        <Setter Property="Foreground" Value="{DynamicResource DshText2Brush}" />
        <Setter Property="FontSize" Value="{DynamicResource DshFontSizeSmall}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.plugin-name">
        <Setter Property="Foreground" Value="{DynamicResource DshTextBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource DshFontSizeBodySmall}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontFamily" Value="Geist Mono, Cascadia Code, Consolas" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.plugin-desc">
        <Setter Property="Foreground" Value="{DynamicResource DshText3Brush}" />
        <Setter Property="FontSize" Value="{DynamicResource DshFontSizeSmall}" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <!-- ============================================================
         控制台
         ============================================================ -->
    <Style Selector="Border.console">
        <Setter Property="Background" Value="{DynamicResource DshBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DshLineSoftBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource DshRadiusMedium}" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="MinHeight" Value="240" />
    </Style>
    <Style Selector="ListBox.console">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.console ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="ListBox.console ListBoxItem:pointerover">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.console ListBoxItem:selected">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TextBlock.log-line">
        <Setter Property="FontFamily" Value="Geist Mono, Cascadia Code, Consolas" />
        <Setter Property="FontSize" Value="{DynamicResource DshFontSizeSmall}" />
        <Setter Property="Foreground" Value="{DynamicResource DshText2Brush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.log-ts">
        <Setter Property="FontFamily" Value="Geist Mono, Cascadia Code, Consolas" />
        <Setter Property="FontSize" Value="{DynamicResource DshFontSizeSmall}" />
        <Setter Property="Foreground" Value="{DynamicResource DshText4Brush}" />
    </Style>
    <Style Selector="TextBlock.log-level">
        <Setter Property="FontFamily" Value="Geist Mono, Cascadia Code, Consolas" />
        <Setter Property="FontSize" Value="{DynamicResource DshFontSizeSmall}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.log-line.log-ok">
        <Setter Property="Foreground" Value="{DynamicResource DshOkBrush}" />
    </Style>
    <Style Selector="TextBlock.log-line.log-warn">
        <Setter Property="Foreground" Value="{DynamicResource DshWarnBrush}" />
    </Style>
    <Style Selector="TextBlock.log-line.log-err">
        <Setter Property="Foreground" Value="{DynamicResource DshErrBrush}" />
    </Style>

    <!-- ============================================================
         指标条（无卡片，发丝线分隔）
         ============================================================ -->
    <Style Selector="Border.statbar">
        <Setter Property="BorderBrush" Value="{DynamicResource DshLineSoftBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource DshRadiusCard}" />
        <Setter Property="Background" Value="{DynamicResource DshSurface1Brush}" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.stat">
        <Setter Property="Padding" Value="18,14" />
        <Setter Property="BorderBrush" Value="{DynamicResource DshLineSoftBrush}" />
        <Setter Property="BorderThickness" Value="1,0,0,0" />
    </Style>
    <Style Selector="TextBlock.stat-key">
        <Setter Property="FontSize" Value="{DynamicResource DshFontSizeSmall}" />
        <Setter Property="Foreground" Value="{DynamicResource DshText3Brush}" />
        <Setter Property="Margin" Value="0,0,0,7" />
    </Style>
    <Style Selector="TextBlock.stat-value">
        <Setter Property="FontSize" Value="21" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontFamily" Value="Geist Mono, Cascadia Code, Consolas" />
        <Setter Property="Foreground" Value="{DynamicResource DshTextBrush}" />
        <Setter Property="Margin" Value="7,0,0,0" />
    </Style>
    <Style Selector="TextBlock.stat-foot">
        <Setter Property="FontSize" Value="{DynamicResource DshFontSizeCaption}" />
        <Setter Property="Foreground" Value="{DynamicResource DshText4Brush}" />
        <Setter Property="Margin" Value="7,7,0,0" />
    </Style>
    <Style Selector="TextBlock.stat-foot.warn">
        <Setter Property="Foreground" Value="{DynamicResource DshWarnBrush}" />
    </Style>

    <!-- ============================================================
         Dashboard 专用
         ============================================================ -->
    <Style Selector="Border.hero">
        <Setter Property="Padding" Value="18,16" />
        <Setter Property="BorderThickness" Value="2,0,0,0" />
        <Setter Property="BorderBrush" Value="{DynamicResource DshOkBrush}" />
        <Setter Property="CornerRadius" Value="0,10,10,0" />
        <Setter Property="Background">
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                <GradientStop Color="#1C3FBF8F" Offset="0" />
                <GradientStop Color="Transparent" Offset="0.46" />
            </LinearGradientBrush>
        </Setter>
    </Style>
    <Style Selector="Border.hero-icon">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="CornerRadius" Value="{DynamicResource DshRadiusMedium}" />
        <Setter Property="Background" Value="{DynamicResource DshOkSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DshOkLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.hero-title">
        <Setter Property="FontSize" Value="{DynamicResource DshFontSizeHero}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.hero-sub">
        <Setter Property="Foreground" Value="{DynamicResource DshText3Brush}" />
        <Setter Property="FontSize" Value="{DynamicResource DshFontSizeBodySmall}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>
    <Style Selector="TextBlock.hero-fact">
        <Setter Property="FontSize" Value="{DynamicResource DshFontSizeSmall}" />
        <Setter Property="Foreground" Value="{DynamicResource DshText3Brush}" />
        <Setter Property="Padding" Value="0,0,12,0" />
        <Setter Property="Margin" Value="0,0,12,0" />
    </Style>

    <Style Selector="Border.wf-track">
        <Setter Property="Height" Value="8" />
        <Setter Property="CornerRadius" Value="99" />
        <Setter Property="Background" Value="{DynamicResource DshSurface3Brush}" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <!-- 条宽由 DashboardView 的 ColumnDefinition.Star 占比驱动（PercentColumnConverter），
         不依赖 transform。这里原本有一个 scaleX 生长动画：RenderTransform 的声明类型是
         ITransform，Avalonia 没有为它注册动画器，会在样式挂载阶段抛
         InvalidOperationException 打死整个应用启动。守卫：ThemeResourceTests。 -->
    <Style Selector="Border.wf-fill">
        <Setter Property="Height" Value="8" />
        <Setter Property="CornerRadius" Value="99" />
        <Setter Property="Background" Value="{DynamicResource DshAccentBrush}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Border.wf-fill.muted">
        <Setter Property="Background" Value="{DynamicResource DshText4Brush}" />
    </Style>

    <Style Selector="Grid.stream-item">
        <Setter Property="Margin" Value="0,10" />
    </Style>
    <Style Selector="Ellipse.stream-dot">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Fill" Value="{DynamicResource DshSurface2Brush}" />
        <Setter Property="Stroke" Value="{DynamicResource DshLineSoftBrush}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="0,1,0,0" />
    </Style>
    <Style Selector="Ellipse.stream-dot.ok">
        <Setter Property="Fill" Value="{DynamicResource DshOkSoftBrush}" />
        <Setter Property="Stroke" Value="{DynamicResource DshOkLineBrush}" />
    </Style>
    <Style Selector="TextBlock.stream-title">
        <Setter Property="FontFamily" Value="Geist Mono, Cascadia Code, Consolas" />
        <Setter Property="FontSize" Value="{DynamicResource DshFontSizeBodySmall}" />
        <Setter Property="Foreground" Value="{DynamicResource DshText2Brush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.stream-meta">
        <Setter Property="FontSize" Value="{DynamicResource DshFontSizeCaption}" />
        <Setter Property="Foreground" Value="{DynamicResource DshText4Brush}" />
        <Setter Property="Margin" Value="0,3,0,0" />
    </Style>

    <!-- ============================================================
         Runtime 状态机
         ============================================================ -->
    <Style Selector="Border.state">
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="CornerRadius" Value="{DynamicResource DshRadiusSmall}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DshLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource DshSurface2Brush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.state TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource DshText3Brush}" />
        <Setter Property="FontFamily" Value="Geist Mono, Cascadia Code, Consolas" />
        <Setter Property="FontSize" Value="{DynamicResource DshFontSizeBodySmall}" />
    </Style>
    <Style Selector="Border.state.current">
        <Setter Property="Background" Value="{DynamicResource DshAccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DshAccentLineBrush}" />
        <Setter Property="BoxShadow" Value="0 0 0 3 #175B7CFA" />
    </Style>
    <Style Selector="Border.state.current TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource DshAccentHiBrush}" />
    </Style>
    <Style Selector="Border.state.current-ok">
        <Setter Property="Background" Value="{DynamicResource DshOkSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DshOkLineBrush}" />
        <Setter Property="BoxShadow" Value="0 0 0 3 #173FBF8F" />
    </Style>
    <Style Selector="Border.state.current-ok TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource DshOkBrush}" />
    </Style>
    <Style Selector="Border.state.off">
        <Setter Property="BorderBrush" Value="{DynamicResource DshLineSoftBrush}" />
        <Setter Property="Opacity" Value="0.7" />
    </Style>
    <Style Selector="Border.state.off TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource DshText4Brush}" />
    </Style>
    <Style Selector="TextBlock.fsm-label">
        <Setter Property="Width" Value="64" />
        <Setter Property="Foreground" Value="{DynamicResource DshText4Brush}" />
        <Setter Property="FontSize" Value="{DynamicResource DshFontSizeCaption}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.fsm-arrow">
        <Setter Property="Foreground" Value="{DynamicResource DshText4Brush}" />
        <Setter Property="FontSize" Value="{DynamicResource DshFontSizeBody}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ============================================================
         空 / 加载
         ============================================================ -->
    <Style Selector="Border.empty">
        <Setter Property="Padding" Value="20,44" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="TextBlock.empty-title">
        <Setter Property="FontSize" Value="{DynamicResource DshFontSizeBodySmall}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource DshText2Brush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.empty-sub">
        <Setter Property="FontSize" Value="{DynamicResource DshFontSizeSmall}" />
        <Setter Property="Foreground" Value="{DynamicResource DshText4Brush}" />
        <Setter Property="Margin" Value="0,5,0,0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- 骨架屏：shimmer（裁剪容器内平移高光带；带宽为固定像素，覆盖常见宽度） -->
    <Style Selector="Border.skel">
        <Setter Property="Height" Value="9" />
        <Setter Property="CornerRadius" Value="99" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="Background" Value="{DynamicResource DshSurface3Brush}" />
    </Style>

    <Style Selector="ProgressBar.bar">
        <Setter Property="Height" Value="6" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Background" Value="{DynamicResource DshSurface4Brush}" />
        <Setter Property="Foreground" Value="{DynamicResource DshAccentBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ============================================================
         提示条
         ============================================================ -->
    <Style Selector="Border.notice">
        <Setter Property="Padding" Value="13,10" />
        <Setter Property="CornerRadius" Value="{DynamicResource DshRadiusSmall}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource DshLineBrush}" />
        <Setter Property="Background" Value="{DynamicResource DshSurface2Brush}" />
    </Style>
    <Style Selector="Border.notice TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource DshText2Brush}" />
    </Style>
    <Style Selector="Border.notice.info">
        <Setter Property="Background" Value="{DynamicResource DshAccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DshAccentLineBrush}" />
    </Style>
    <Style Selector="Border.notice.info TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource DshAccentHiBrush}" />
    </Style>
    <Style Selector="TextBlock.notice-title">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>

    <!-- ============================================================
         浮层（scrim / modal / toast / bar）
         ============================================================ -->
    <Style Selector="Border.scrim">
        <Setter Property="Background" Value="{DynamicResource DshScrimBrush}" />
    </Style>
    <Style Selector="Border.modal">
        <Setter Property="Width" Value="400" />
        <Setter Property="MaxWidth" Value="480" />
        <Setter Property="Background" Value="{DynamicResource DshSurface2Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DshLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource DshRadiusCard}" />
        <Setter Property="BoxShadow" Value="0 24 56 -16 #B8000000, 0 2 8 0 #80000000" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="TextBlock.modal-title">
        <Setter Property="FontSize" Value="{DynamicResource DshFontSizeTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.modal-body">
        <Setter Property="FontSize" Value="{DynamicResource DshFontSizeBodySmall}" />
        <Setter Property="Foreground" Value="{DynamicResource DshText3Brush}" />
        <Setter Property="Margin" Value="0,7,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Border.modal-code">
        <Setter Property="Margin" Value="0,12,0,0" />
        <Setter Property="Padding" Value="11,9" />
        <Setter Property="CornerRadius" Value="{DynamicResource DshRadiusBadge}" />
        <Setter Property="Background" Value="{DynamicResource DshBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DshLineSoftBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.modal-code TextBlock">
        <Setter Property="FontFamily" Value="Geist Mono, Cascadia Code, Consolas" />
        <Setter Property="FontSize" Value="{DynamicResource DshFontSizeSmall}" />
        <Setter Property="Foreground" Value="{DynamicResource DshText2Brush}" />
    </Style>
    <Style Selector="Border.modal-foot">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="20,14" />
        <Setter Property="BorderBrush" Value="{DynamicResource DshLineSoftBrush}" />
        <Setter Property="BorderThickness" Value="1,0,0,0" />
        <Setter Property="Background" Value="{DynamicResource DshSurface1Brush}" />
    </Style>

    <Style Selector="Border.toast">
        <Setter Property="Padding" Value="14,11" />
        <Setter Property="CornerRadius" Value="{DynamicResource DshRadiusSmall}" />
        <Setter Property="Background" Value="{DynamicResource DshSurface3Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DshLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BoxShadow" Value="0 24 56 -16 #B8000000, 0 2 8 0 #80000000" />
    </Style>
    <Style Selector="Border.toast TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource DshTextBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource DshFontSizeBodySmall}" />
    </Style>

    <Style Selector="StackPanel.bar">
        <Setter Property="Spacing" Value="10" />
        <Setter Property="Margin" Value="0,0,0,14" />
    </Style>
    <!-- 兼容别名：旧视图用 Classes="toolbar" -->
    <Style Selector="StackPanel.toolbar">
        <Setter Property="Spacing" Value="8" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!-- ============================================================
         历史遗留类名
         ready-icon 是 Dashboard 换代前留下的状态图标容器（26px，比契约的 hero-icon
         38px 更适合 Runtime 页的紧凑状态行），故保留。其余旧类名（hero-main /
         health-status / metric-* / timeline-* / activity-* / card-subtitle 之外的同族 /
         btn small / TextBox.search）已随本轮视图重排全部退场，不再保留兼容别名。
         ============================================================ -->
    <Style Selector="Border.ready-icon">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="CornerRadius" Value="13" />
        <Setter Property="Background" Value="{DynamicResource DshOkSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DshOkLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</Styles>
