<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- -windows 后缀：引用 DshDesktop.Platform.Windows（net10.0-windows）所需；Avalonia/AOT 均兼容。 -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <!-- §31 修订（Q6-A）：Release + 指定 RID 即 AOT（dotnet publish -c Release -r win-x64）；
       无 RID 的 Release 构建不触发 AOT（AOT 必须有 RID，避免 dotnet build -c Release 炸掉）。 -->
  <PropertyGroup Condition="'$(Configuration)'=='Release' and '$(RuntimeIdentifier)' != ''">
    <PublishAot>true</PublishAot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="Serilog" Version="4.3.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DshDesktop.Infrastructure\DshDesktop.Infrastructure.csproj" />
    <ProjectReference Include="..\DshDesktop.Platform.Windows\DshDesktop.Platform.Windows.csproj" />
    <ProjectReference Include="..\DshDesktop.Presentation.Avalonia\DshDesktop.Presentation.Avalonia.csproj" />
  </ItemGroup>
</Project>
