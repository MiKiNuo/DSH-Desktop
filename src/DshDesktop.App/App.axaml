<Application
    x:Class="DshDesktop.App.App"
    RequestedThemeVariant="Dark"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Styles>
        <FluentTheme />
        <!-- DSH 暗色主题（Phase 8 Issue 02）：原型色板 + class 语义样式族，各视图按 Classes 引用。 -->
        <StyleInclude Source="avares://DshDesktop.Presentation.Avalonia/Themes/DshTheme.axaml" />
    </Application.Styles>
</Application>
