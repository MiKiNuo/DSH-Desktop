<Window
    x:Class="DshDesktop.App.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:DshDesktop.Presentation.Avalonia.Features.AppShell;assembly=DshDesktop.Presentation.Avalonia"
    x:DataType="shell:AppShellViewModel"
    Title="DSH Desktop"
    Width="1280"
    Height="800"
    MinWidth="960"
    MinHeight="600">
    <!--
      应用壳（UI 重设计 v2）：侧栏（品牌 + Workspace/Management/System 三组导航 + runtime-mini，
      可折叠 248↔72）+ 52px 顶栏（页标题/副标题 + 打开工作台 ghost）+ 内容区 + 28px 分段式状态栏
      + toast 浮层 + 二次确认弹层（壳负责渲染，ConfirmDialog 注册 RequestConfirmAsync）。
      侧栏列宽由 SidebarLayout.ExpandedWidth 驱动（ApplySidebarState 按 WidthFor 设列宽）。
    -->
    <Grid>
        <!-- 侧栏列宽：展开 248 / 折叠 72，唯一来源 SidebarLayout（单测）。
             XAML 里的 248 只是设计期默认值，运行时由 ApplySidebarState 按 WidthFor 覆写。 -->
        <Grid x:Name="ShellGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== 侧栏 ===== -->
            <Border Classes="sidebar" Grid.Column="0">
                <Grid RowDefinitions="Auto,*">
                    <StackPanel Grid.Row="0">
                        <!-- 品牌行即折叠开关：整行可点，点击 → ToggleSidebarCommand。 -->
                        <Button x:Name="SidebarToggle" Classes="brand">
                            <Grid x:Name="BrandRow" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="BrandMark" Classes="brand-mark" Grid.Column="0">
                                    <TextBlock Classes="brand-mark-text" Text="D" />
                                </Border>
                                <StackPanel
                                    x:Name="BrandTextPanel"
                                    Grid.Column="1"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                                    <TextBlock Classes="brand-title" Text="DSH Desktop" />
                                    <TextBlock Classes="brand-sub" Text="Stable Runtime Host" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <TextBlock x:Name="NavLabelWorkspace" Classes="nav-label" Text="WORKSPACE" />
                        <Border x:Name="NavRuleWorkspace" Height="1" Margin="0,9,0,9"
                                Background="{DynamicResource DshLineSoftBrush}" IsVisible="False" />

                        <Button
                            x:Name="NavDashboard"
                            Classes="nav-btn"
                            Command="{Binding ShowDashboardCommand}">
                            <Grid ColumnDefinitions="20,*">
                                <Path Classes="icon" Data="{DynamicResource IconDashboard}" HorizontalAlignment="Center" />
                                <TextBlock x:Name="NavDashboardText" Grid.Column="1" VerticalAlignment="Center" Text="概览" />
                            </Grid>
                        </Button>
                        <Button
                            x:Name="NavWorkbench"
                            Classes="nav-btn"
                            Command="{Binding ShowWorkbenchCommand}">
                            <Grid ColumnDefinitions="20,*">
                                <Path Classes="icon" Data="{DynamicResource IconTerminal}" HorizontalAlignment="Center" />
                                <TextBlock x:Name="NavWorkbenchText" Grid.Column="1" VerticalAlignment="Center" Text="DSH 工作台" />
                            </Grid>
                        </Button>

                        <TextBlock x:Name="NavLabelManagement" Classes="nav-label" Text="MANAGEMENT" />
                        <Border x:Name="NavRuleManagement" Height="1" Margin="0,9,0,9"
                                Background="{DynamicResource DshLineSoftBrush}" IsVisible="False" />

                        <Button
                            x:Name="NavPlugins"
                            Classes="nav-btn"
                            Command="{Binding ShowPluginsCommand}">
                            <Grid ColumnDefinitions="20,*">
                                <Path Classes="icon" Data="{DynamicResource IconPackage}" HorizontalAlignment="Center" />
                                <TextBlock x:Name="NavPluginsText" Grid.Column="1" VerticalAlignment="Center" Text="插件管理" />
                            </Grid>
                        </Button>
                        <Button
                            x:Name="NavRuntime"
                            Classes="nav-btn"
                            Command="{Binding ShowRuntimeCommand}">
                            <Grid ColumnDefinitions="20,*">
                                <Path Classes="icon" Data="{DynamicResource IconCpu}" HorizontalAlignment="Center" />
                                <TextBlock x:Name="NavRuntimeText" Grid.Column="1" VerticalAlignment="Center" Text="运行环境" />
                            </Grid>
                        </Button>
                        <Button
                            x:Name="NavUpdates"
                            Classes="nav-btn"
                            Command="{Binding ShowUpdatesCommand}">
                            <Grid ColumnDefinitions="20,*,Auto">
                                <Path Classes="icon" Data="{DynamicResource IconRefresh}" HorizontalAlignment="Center" />
                                <TextBlock x:Name="NavUpdatesText" Grid.Column="1" VerticalAlignment="Center" Text="更新中心" />
                                <Border
                                    x:Name="UpdatesBadgeBox"
                                    Classes="nav-badge"
                                    Grid.Column="2"
                                    IsVisible="False">
                                    <TextBlock x:Name="UpdatesBadgeText" />
                                </Border>
                            </Grid>
                        </Button>
                        <Button
                            x:Name="NavDiagnostics"
                            Classes="nav-btn"
                            Command="{Binding ShowDiagnosticsCommand}">
                            <Grid ColumnDefinitions="20,*">
                                <Path Classes="icon" Data="{DynamicResource IconActivity}" HorizontalAlignment="Center" />
                                <TextBlock x:Name="NavDiagnosticsText" Grid.Column="1" VerticalAlignment="Center" Text="诊断中心" />
                            </Grid>
                        </Button>

                        <TextBlock x:Name="NavLabelSystem" Classes="nav-label" Text="SYSTEM" />
                        <Border x:Name="NavRuleSystem" Height="1" Margin="0,9,0,9"
                                Background="{DynamicResource DshLineSoftBrush}" IsVisible="False" />

                        <Button
                            x:Name="NavSettings"
                            Classes="nav-btn"
                            Command="{Binding ShowSettingsCommand}">
                            <Grid ColumnDefinitions="20,*">
                                <Path Classes="icon" Data="{DynamicResource IconSliders}" HorizontalAlignment="Center" />
                                <TextBlock x:Name="NavSettingsText" Grid.Column="1" VerticalAlignment="Center" Text="设置" />
                            </Grid>
                        </Button>
                    </StackPanel>

                    <!-- runtime-mini：Runtime 状态点+Lifecycle / Desktop 版本 / DSH 版本 -->
                    <Border
                        x:Name="RuntimeMini"
                        Classes="runtime-mini"
                        Grid.Row="1"
                        VerticalAlignment="Bottom">
                        <StackPanel Spacing="7">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse
                                        x:Name="MiniStatusDot"
                                        Width="7"
                                        Height="7"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center" />
                                    <TextBlock Classes="runtime-mini-text" Text="DSH Runtime" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Column="1"
                                    Classes="runtime-mini-text"
                                    FontWeight="Bold"
                                    Text="{Binding RuntimeLifecycleText}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="runtime-mini-text" Text="Desktop" />
                                <TextBlock
                                    Grid.Column="1"
                                    Classes="runtime-mini-text"
                                    Text="{Binding DesktopVersion, StringFormat='v{0}'}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="runtime-mini-text" Text="DSH" />
                                <TextBlock
                                    Grid.Column="1"
                                    Classes="runtime-mini-text"
                                    Text="{Binding DshVersion, FallbackValue='—', TargetNullValue='—'}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ===== 工作区：顶栏 + 内容 + 状态栏 ===== -->
            <Grid Grid.Column="1" RowDefinitions="52,*,28">
                <Border Classes="topbar" Grid.Row="0">
                    <Grid>
                        <StackPanel
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                            <TextBlock Classes="page-title" Text="{Binding PageTitle}" />
                            <TextBlock Classes="page-desc" Text="{Binding PageSubtitle}" />
                        </StackPanel>
                        <!-- 顶栏右侧仅保留一个 ghost 按钮，避免与 Dashboard 页内 primary 同屏冲突。 -->
                        <Button
                            Classes="btn ghost"
                            HorizontalAlignment="Right"
                            Command="{Binding ShowWorkbenchCommand}"
                            Content="打开工作台" />
                    </Grid>
                </Border>

                <ContentControl
                    x:Name="RootContent"
                    Grid.Row="1" />

                <!-- 状态栏：分段式，段间 1px 竖发丝线；数值用等宽字体。 -->
                <Border Classes="statusbar" Grid.Row="2">
                    <DockPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                            <TextBlock Classes="statusbar-text" Text="Desktop" />
                            <TextBlock
                                Classes="statusbar-text"
                                FontFamily="Geist Mono, Cascadia Code, Consolas"
                                Text="{Binding DesktopVersion, StringFormat=' v{0}'}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Ellipse x:Name="StatusBarDot" Width="7" Height="7" VerticalAlignment="Center" />
                                <TextBlock Classes="statusbar-text" Text="{Binding RuntimeLifecycleText, StringFormat='DSH {0}'}" />
                            </StackPanel>
                            <Border Width="1" Margin="12,4" Background="{DynamicResource DshLineSoftBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Classes="statusbar-text" Text="PID" />
                                <TextBlock
                                    Classes="statusbar-text"
                                    FontFamily="Geist Mono, Cascadia Code, Consolas"
                                    Text="{Binding RuntimeProcessId, StringFormat=' {0}', FallbackValue=' —', TargetNullValue=' —'}" />
                            </StackPanel>
                            <Border Width="1" Margin="12,4" Background="{DynamicResource DshLineSoftBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Classes="statusbar-text" Text="Port" />
                                <TextBlock
                                    Classes="statusbar-text"
                                    FontFamily="Geist Mono, Cascadia Code, Consolas"
                                    Text="{Binding RuntimePort, StringFormat=' {0}', FallbackValue=' —', TargetNullValue=' —'}" />
                            </StackPanel>
                            <Border Width="1" Margin="12,4" Background="{DynamicResource DshLineSoftBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Classes="statusbar-text" Text="启动" />
                                <TextBlock
                                    Classes="statusbar-text"
                                    FontFamily="Geist Mono, Cascadia Code, Consolas"
                                    Text="{Binding StartupElapsedText, StringFormat=' {0}'}" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ===== toast 浮层（右下角，自动消隐） ===== -->
        <Border
            x:Name="ToastBox"
            Classes="toast"
            Margin="0,0,18,42"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            IsHitTestVisible="False"
            IsVisible="False">
            <TextBlock x:Name="ToastText" />
        </Border>

        <!-- ===== 二次确认弹层（壳渲染；ConfirmDialog.Register 接线 RequestConfirmAsync） ===== -->
        <Border x:Name="ConfirmScrim" Classes="scrim" IsVisible="False">
            <Border x:Name="ConfirmModal" Classes="modal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto">
                    <TextBlock x:Name="ConfirmTitle" Classes="modal-title" Grid.Row="0" Margin="20,18,20,0" />
                    <TextBlock x:Name="ConfirmBody" Classes="modal-body" Grid.Row="1" Margin="20,0,20,0" />
                    <Border x:Name="ConfirmCode" Classes="modal-code" Grid.Row="2">
                        <TextBlock x:Name="ConfirmSubject" />
                    </Border>
                    <Border Classes="modal-foot" Grid.Row="3" Margin="0,16,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="20,14">
                            <Button x:Name="ConfirmCancel" Classes="btn secondary" Content="取消" />
                            <Button x:Name="ConfirmOk" Classes="btn primary" Content="确认" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
