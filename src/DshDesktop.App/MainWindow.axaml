<Window
    x:Class="DshDesktop.App.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:DshDesktop.Presentation.Avalonia.Features.AppShell;assembly=DshDesktop.Presentation.Avalonia"
    x:DataType="shell:AppShellViewModel"
    Title="DSH Desktop"
    Width="1280"
    Height="800"
    MinWidth="960"
    MinHeight="600">
    <Grid ColumnDefinitions="Auto,*">
        <Border
            Grid.Column="0"
            MinWidth="180"
            Padding="12"
            Background="#161B22">
            <Grid RowDefinitions="*,Auto">
                <StackPanel Grid.Row="0" Spacing="8">
                    <TextBlock
                        Margin="4,0,0,8"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="DSH Desktop" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Button
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Command="{Binding ShowRuntimeCommand}"
                            Content="Runtime" />
                        <Ellipse
                            x:Name="RuntimeStatusDot"
                            Grid.Column="1"
                            Width="10"
                            Height="10"
                            Margin="6,0,0,0"
                            VerticalAlignment="Center" />
                    </Grid>
                    <Button
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Command="{Binding ShowDashboardCommand}"
                        Content="Dashboard" />
                    <Button
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Command="{Binding ShowWorkbenchCommand}"
                        Content="Workbench" />
                    <Button
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Command="{Binding ShowDiagnosticsCommand}"
                        Content="Diagnostics" />
                    <Button
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Command="{Binding ShowPluginsCommand}"
                        Content="Plugins" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Button
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Command="{Binding ShowUpdatesCommand}"
                            Content="Updates" />
                        <Border
                            x:Name="UpdateBadgeBox"
                            Grid.Column="1"
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            Background="#22C55E"
                            CornerRadius="8"
                            IsVisible="False"
                            Padding="6,1">
                            <TextBlock
                                x:Name="UpdateBadgeText"
                                FontSize="11"
                                Foreground="White" />
                        </Border>
                    </Grid>
                    <Button
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Command="{Binding ShowSettingsCommand}"
                        Content="Settings" />
                </StackPanel>
                <TextBlock
                    Grid.Row="1"
                    Margin="4,8,0,0"
                    FontSize="11"
                    Foreground="#6E7681"
                    Text="{Binding DesktopVersion, StringFormat='v{0}'}" />
            </Grid>
        </Border>
        <ContentControl Grid.Column="1" x:Name="RootContent" />
    </Grid>
</Window>
