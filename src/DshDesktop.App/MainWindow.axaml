<Window
    x:Class="DshDesktop.App.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:DshDesktop.Presentation.Avalonia.Features.AppShell;assembly=DshDesktop.Presentation.Avalonia"
    x:DataType="shell:AppShellViewModel"
    Title="DSH Desktop"
    Width="1280"
    Height="800"
    MinWidth="960"
    MinHeight="600">
    <Grid ColumnDefinitions="Auto,*">
        <Border
            Grid.Column="0"
            MinWidth="180"
            Padding="12"
            Background="#161B22">
            <StackPanel Spacing="8">
                <TextBlock
                    Margin="4,0,0,8"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="DSH Desktop" />
                <Button
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Command="{Binding ShowRuntimeCommand}"
                    Content="Runtime" />
                <Button
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Command="{Binding ShowWorkbenchCommand}"
                    Content="Workbench" />
                <Button
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Command="{Binding ShowDiagnosticsCommand}"
                    Content="Diagnostics" />
                <Button
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Command="{Binding ShowPluginsCommand}"
                    Content="Plugins" />
                <Button
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Command="{Binding ShowUpdatesCommand}"
                    Content="Updates" />
            </StackPanel>
        </Border>
        <ContentControl Grid.Column="1" x:Name="RootContent" />
    </Grid>
</Window>
