<Window
    x:Class="DshDesktop.App.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:DshDesktop.Presentation.Avalonia.Features.AppShell;assembly=DshDesktop.Presentation.Avalonia"
    x:DataType="shell:AppShellViewModel"
    Title="DSH Desktop"
    Width="1280"
    Height="800"
    MinWidth="1100"
    MinHeight="600"
    WindowDecorations="Full"
    ExtendClientAreaToDecorationsHint="True"
    ExtendClientAreaTitleBarHeightHint="52">
    <!--
      应用壳（顶部导航）：客户区扩展到装饰区（ExtendClientAreaToDecorationsHint /
      ExtendClientAreaTitleBarHeightHint="52"），`WindowDecorations="Full"` 保留系统绘制的边框/阴影/缩放。
      ⚠️ 但标题栏文字与右上角 caption 按钮是 **Avalonia 自绘**的（WindowDrawnDecorations，见
      App.axaml 注释与 WindowCaptionButtons.cs 的机制说明；此前记为「系统绘制」是误判）。

      ⚠️ 为什么不是 BorderOnly：BorderOnly 在**实机**上验证无效——它并没有去掉原生标题栏，
      窗口反而渲染成两行（顶部一行带 min/max/close，应用顶栏被挤到第二行），
      caption 按钮也落在了那一行，用户看到的就是「按钮消失」。故固定用 Full。

      ⚠️ 品牌只保留 logo 瓦片（brand-mark）：窗口标题文字（Title="DSH Desktop"）由 **Avalonia 自绘**
      的标题栏（WindowDrawnDecorations 的 PART_TitleTextPanel）绘在该行左上角，
      自带的品牌文字会与它叠印成重影，正是最初的投诉。logo 向右推（顶栏 StackPanel 的 Margin）
      以避开该文字区，该值为估计值，需实机微调。

      ⚠️ 标题栏高度 52 必须与 RowDefinitions 首行、ExtendClientAreaTitleBarHeightHint 两处一致。
      ⚠️ 右侧避让 caption 区 = 运行时实测：右上角按钮组由 Fluent 主题自绘（全屏/最小化/最大化/关闭，
      各 45 DIP + 间距 2），现已在 App.axaml 隐藏「全屏」一个按钮（用户决策），保留最小化 / 最大化 / 关闭
      （标准窗口功能，用户明确要求不要动）。「全屏」按钮正是 2026-09-14 两次「右侧动作被遮挡」的真凶
      （组宽 186 DIP，比按三按钮估算的避让量多出 40 DIP，多出的部分正落在最左那个按钮上），
      当时误判为最大化按钮。故由 code-behind 用 Win32 GetSystemMetricsForDpi 实测三按钮总宽动态设置
      TopNav.Padding（见 WindowCaptionButtons.cs），XAML 不带 Padding。
      ⚠️ 最大化**保持可用**（同日用户澄清：「最小、最大、关闭是（几乎）所有桌面软件都有的功能」）：
      不得声明 CanMaximize="False"，也不得复活 2026-09-14 那套移除 WS_MAXIMIZEBOX 的 P/Invoke——
      它既隐藏/置灰不了自绘按钮（启用态取 Window.CanMaximize），还会连带让「双击顶栏最大化」失效。
      守卫 Shell_MinMaxCloseStayAvailable。全屏退出死代码（托盘项/Esc/ExitFullScreen）随全屏决策已删除。
      （品牌 StackPanel 的 Margin 仍是「不写死像素」的故意例外：框架只暴露标题栏交互元素的度量，
      不暴露标题文字宽度的度量，故 logo 偏移只能是估计值。）
      下方依次为内容区 + 28px 分段式状态栏 + toast 浮层 + 二次确认弹层
      （壳负责渲染，ConfirmDialog 注册 RequestConfirmAsync）。
      原 30px 页标题条（Border.pagebar）已移除：顶栏之下直接是内容区。
      侧栏与折叠状态机已整块移除；拓扑约束见 tests/DshDesktop.Tests/ShellTopNavTests.cs。
      （Avalonia 12 已移除 ExtendClientAreaChromeHints / TitleBar / CaptionButtons / ChromeOverlayLayer。）
    -->
    <Grid>
        <Grid RowDefinitions="52,*,28">
            <!-- ===== 顶部导航 ===== -->
            <Border
                x:Name="TopNav"
                Classes="topnav"
                Grid.Row="0">
                <Grid ColumnDefinitions="Auto,*">
                    <!-- 品牌：logo 瓦片。窗口标题文字（Title="DSH Desktop"）由 Avalonia 自绘的标题栏
                         （WindowDrawnDecorations 的 PART_TitleTextPanel）绘在该行左上角，
                         故 logo 向右推以避开标题文字区。Margin 为估计值，可能需实机微调。 -->
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="10"
                        Margin="110,0,0,0"
                        VerticalAlignment="Center">
                        <Border Classes="brand-mark">
                            <TextBlock Classes="brand-mark-text" Text="D" />
                        </Border>
                    </StackPanel>

                    <!-- 导航：三组，组间竖发丝线 -->
                    <StackPanel
                        Grid.Column="1"
                        Margin="20,0,0,0"
                        Orientation="Horizontal"
                        Spacing="2"
                        VerticalAlignment="Center">
                        <Button
                            x:Name="NavDashboard"
                            Classes="nav-btn"
                            Command="{Binding ShowDashboardCommand}">
                            <Grid ColumnDefinitions="20,*">
                                <Path Classes="icon" Data="{DynamicResource IconDashboard}" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="概览" />
                            </Grid>
                        </Button>
                        <Button
                            x:Name="NavWorkbench"
                            Classes="nav-btn"
                            Command="{Binding ShowWorkbenchCommand}">
                            <Grid ColumnDefinitions="20,*">
                                <Path Classes="icon" Data="{DynamicResource IconTerminal}" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="DSH 工作台" />
                            </Grid>
                        </Button>

                        <Border Classes="nav-rule" />

                        <Button
                            x:Name="NavPlugins"
                            Classes="nav-btn"
                            Command="{Binding ShowPluginsCommand}">
                            <Grid ColumnDefinitions="20,*">
                                <Path Classes="icon" Data="{DynamicResource IconPackage}" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="插件管理" />
                            </Grid>
                        </Button>
                        <Button
                            x:Name="NavRuntime"
                            Classes="nav-btn"
                            Command="{Binding ShowRuntimeCommand}">
                            <Grid ColumnDefinitions="20,*">
                                <Path Classes="icon" Data="{DynamicResource IconCpu}" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="运行环境" />
                            </Grid>
                        </Button>
                        <Button
                            x:Name="NavUpdates"
                            Classes="nav-btn"
                            Command="{Binding ShowUpdatesCommand}">
                            <Grid ColumnDefinitions="20,*,Auto">
                                <Path Classes="icon" Data="{DynamicResource IconRefresh}" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="更新中心" />
                                <Border
                                    x:Name="UpdatesBadgeBox"
                                    Classes="nav-badge"
                                    Grid.Column="2"
                                    IsVisible="False">
                                    <TextBlock x:Name="UpdatesBadgeText" />
                                </Border>
                            </Grid>
                        </Button>
                        <Button
                            x:Name="NavDiagnostics"
                            Classes="nav-btn"
                            Command="{Binding ShowDiagnosticsCommand}">
                            <Grid ColumnDefinitions="20,*">
                                <Path Classes="icon" Data="{DynamicResource IconActivity}" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="诊断中心" />
                            </Grid>
                        </Button>

                        <Border Classes="nav-rule" />

                        <Button
                            x:Name="NavSettings"
                            Classes="nav-btn"
                            Command="{Binding ShowSettingsCommand}">
                            <Grid ColumnDefinitions="20,*">
                                <Path Classes="icon" Data="{DynamicResource IconSliders}" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="设置" />
                            </Grid>
                        </Button>
                    </StackPanel>

                    <!-- 顶栏右内边距避让 caption 按钮区：由 code-behind（MainWindow.ApplyCaptionAvoidance）用
                         Win32 GetSystemMetricsForDpi 实测三按钮（min/max/close）总宽动态设置 TopNav.Padding。
                         「全屏」按钮已于 2026-09-15 在 App.axaml 隐藏（用户决策）；右侧「打开工作台」按钮同日
                         移除（与导航「DSH 工作台」重复）。Padding 仍保留，防窄窗口时导航末项撞按钮。
                         XAML 不写死像素：避让宽度依赖主题的按钮实现，且 WindowDecorationMargin binding
                         在 Full + Windows 下取值不可靠（均为 2026-09-14 实机回归）。
                         窗口拖动：**顶栏必须自报拖拽区**——Avalonia 12 的拖拽区是「带
                         WindowDecorationProperties.ElementRole 的装饰元素」，Fluent 模板里唯一带
                         TitleBar 角色的 Panel#PART_TitleBar 在 **Underlay 层（客户区内容之下）**，
                         会被本层不透明的 Border.topnav 完整盖住 ⇒ 必须由顶栏自己声明角色。
                         故在 DshTheme.axaml 给 Border.topnav 设 TitleBar（导航按钮配 User 防吞点击）。
                         （此前记「框架会替扩展装饰区走 HTCAPTION，topnav 不必自报」是**误判**，
                         2026-09-15 实机投诉「左键按住顶栏不能移动窗口」修正。） -->
                </Grid>
            </Border>

            <ContentControl
                x:Name="RootContent"
                Grid.Row="1" />

            <!-- ===== 更新中全屏遮罩（阻止导航；复用 scrim 视觉，§11.2 壳投影 UpdateInProgress） =====
                 loading 框语义（2026-09-15 实机投诉修正）：中央默认是**旋转图标**（等待中），
                 仅当 Desktop 下载存在真实百分比时才由 code-behind 切成确定进度条——二者互斥。
                 不得在 XAML 写死 IsIndeterminate 进度条：来回扫的滑块与"进度"不可区分。 -->
            <Border x:Name="UpdateScrim" Classes="scrim" Grid.Row="1" IsVisible="False">
                <Grid
                    Width="320"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    RowDefinitions="Auto,Auto,Auto">
                    <TextBlock
                        Classes="modal-title"
                        Grid.Row="0"
                        HorizontalAlignment="Center"
                        Text="更新进行中" />
                    <Panel Grid.Row="1" Height="26" Margin="0,14,0,0">
                        <Path
                            x:Name="UpdateSpinner"
                            Classes="spinner"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="M 11 2 A 9 9 0 1 0 20 11" />
                        <ProgressBar
                            x:Name="UpdateProgress"
                            Classes="bar"
                            Width="280"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsVisible="False" />
                    </Panel>
                    <TextBlock
                        x:Name="UpdateScrimText"
                        Classes="modal-body"
                        Grid.Row="2"
                        HorizontalAlignment="Center"
                        Margin="0,10,0,0"
                        Text="正在处理更新，请稍候…" />
                </Grid>
            </Border>

            <!-- 状态栏：分段式，段间 1px 竖发丝线；数值用等宽字体。 -->
            <Border Classes="statusbar" Grid.Row="2">
                <DockPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <TextBlock Classes="statusbar-text" Text="DSH" />
                        <TextBlock
                            Classes="statusbar-text"
                            FontFamily="Geist Mono, Cascadia Code, Consolas"
                            Text="{Binding DshVersion, StringFormat=' {0}', FallbackValue=' —', TargetNullValue=' —'}" />
                        <Border Width="1" Margin="12,4" Background="{DynamicResource DshLineSoftBrush}" />
                        <TextBlock Classes="statusbar-text" Text="Desktop" />
                        <TextBlock
                            Classes="statusbar-text"
                            FontFamily="Geist Mono, Cascadia Code, Consolas"
                            Text="{Binding DesktopVersion, StringFormat=' v{0}'}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusBarDot" Width="7" Height="7" VerticalAlignment="Center" />
                            <TextBlock Classes="statusbar-text" Text="{Binding RuntimeLifecycleText, StringFormat='DSH {0}'}" />
                        </StackPanel>
                        <Border Width="1" Margin="12,4" Background="{DynamicResource DshLineSoftBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Classes="statusbar-text" Text="PID" />
                            <TextBlock
                                Classes="statusbar-text"
                                FontFamily="Geist Mono, Cascadia Code, Consolas"
                                Text="{Binding RuntimeProcessId, StringFormat=' {0}', FallbackValue=' —', TargetNullValue=' —'}" />
                        </StackPanel>
                        <Border Width="1" Margin="12,4" Background="{DynamicResource DshLineSoftBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Classes="statusbar-text" Text="Port" />
                            <TextBlock
                                Classes="statusbar-text"
                                FontFamily="Geist Mono, Cascadia Code, Consolas"
                                Text="{Binding RuntimePort, StringFormat=' {0}', FallbackValue=' —', TargetNullValue=' —'}" />
                        </StackPanel>
                        <Border Width="1" Margin="12,4" Background="{DynamicResource DshLineSoftBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Classes="statusbar-text" Text="启动" />
                            <TextBlock
                                Classes="statusbar-text"
                                FontFamily="Geist Mono, Cascadia Code, Consolas"
                                Text="{Binding StartupElapsedText, StringFormat=' {0}'}" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ===== toast 浮层（右下角，自动消隐） ===== -->
        <Border
            x:Name="ToastBox"
            Classes="toast"
            Margin="0,0,18,42"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            IsHitTestVisible="False"
            IsVisible="False">
            <TextBlock x:Name="ToastText" />
        </Border>

        <!-- ===== 二次确认弹层（壳渲染；ConfirmDialog.Register 接线 RequestConfirmAsync） ===== -->
        <Border x:Name="ConfirmScrim" Classes="scrim" IsVisible="False">
            <Border Classes="modal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto">
                    <TextBlock x:Name="ConfirmTitle" Classes="modal-title" Grid.Row="0" Margin="20,18,20,0" />
                    <TextBlock x:Name="ConfirmBody" Classes="modal-body" Grid.Row="1" Margin="20,0,20,0" />
                    <Border Classes="modal-code" Grid.Row="2">
                        <TextBlock x:Name="ConfirmSubject" />
                    </Border>
                    <Border Classes="modal-foot" Grid.Row="3" Margin="0,16,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="20,14">
                            <Button x:Name="ConfirmCancel" Classes="btn secondary" Content="取消" />
                            <Button x:Name="ConfirmOk" Classes="btn primary" Content="确认" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Border>

        <!-- ===== 首启 Runtime 安装弹层（缺 DSH Runtime 时 App 引导自检触发；壳渲染三态：询问/进度/失败，
                 文案集中在 RuntimeSetupText，code-behind 填充，XAML 不写死文本） ===== -->
        <Border x:Name="SetupScrim" Classes="scrim" IsVisible="False">
            <Border Classes="modal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto">
                    <TextBlock x:Name="SetupTitle" Classes="modal-title" Grid.Row="0" Margin="20,18,20,0" />
                    <TextBlock x:Name="SetupBody" Classes="modal-body" Grid.Row="1" Margin="20,0,20,0" />
                    <Panel x:Name="SetupProgressPanel" Grid.Row="2" Margin="20,16,20,0" IsVisible="False">
                        <ProgressBar x:Name="SetupProgress" Classes="bar" Width="360" />
                    </Panel>
                    <Border Classes="modal-foot" Grid.Row="3" Margin="0,16,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                            <Button x:Name="SetupDecline" Classes="btn secondary" />
                            <Button x:Name="SetupAccept" Classes="btn primary" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
