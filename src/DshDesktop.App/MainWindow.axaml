<Window
    x:Class="DshDesktop.App.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:DshDesktop.Presentation.Avalonia.Features.AppShell;assembly=DshDesktop.Presentation.Avalonia"
    x:DataType="shell:AppShellViewModel"
    Title="DSH Desktop"
    Width="1280"
    Height="800"
    MinWidth="960"
    MinHeight="600">
    <Grid ColumnDefinitions="Auto,*">
        <Border
            Grid.Column="0"
            MinWidth="180"
            Padding="12"
            Background="#161B22">
            <Grid RowDefinitions="*,Auto">
                <StackPanel Grid.Row="0" Spacing="8">
                    <TextBlock
                        Margin="4,0,0,8"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="DSH Desktop" />
                    <Button
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Command="{Binding ShowRuntimeCommand}"
                        Content="Runtime" />
                    <Button
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Command="{Binding ShowDashboardCommand}"
                        Content="Dashboard" />
                    <Button
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Command="{Binding ShowWorkbenchCommand}"
                        Content="Workbench" />
                    <Button
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Command="{Binding ShowDiagnosticsCommand}"
                        Content="Diagnostics" />
                    <Button
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Command="{Binding ShowPluginsCommand}"
                        Content="Plugins" />
                    <Button
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Command="{Binding ShowUpdatesCommand}"
                        Content="Updates" />
                    <Button
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Command="{Binding ShowSettingsCommand}"
                        Content="Settings" />
                </StackPanel>
                <TextBlock
                    Grid.Row="1"
                    Margin="4,8,0,0"
                    FontSize="11"
                    Foreground="#6E7681"
                    Text="{Binding DesktopVersion, StringFormat='v{0}'}" />
            </Grid>
        </Border>
        <ContentControl Grid.Column="1" x:Name="RootContent" />
    </Grid>
</Window>
